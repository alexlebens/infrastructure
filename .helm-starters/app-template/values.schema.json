{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["<APP_NAME>"],
  "properties": {
    "<APP_NAME>": {
      "type": "object",
      "required": ["controllers"],
      "properties": {
        "controllers": {
          "type": "object",
          "required": ["main"],
          "properties": {
            "main": {
              "type": "object",
              "required": ["containers"],
              "properties": {
                "containers": {
                  "type": "object",
                  "required": ["main"],
                  "properties": {
                    "main": {
                      "type": "object",
                      "required": ["image"],
                      "properties": {
                        "image": {
                          "type": "object",
                          "required": ["repository", "tag"],
                          "properties": {
                            "repository": {
                              "type": "string",
                              "minLength": 1
                            },
                            "tag": {
                              "type": "string",
                              "minLength": 1,
                              "not": {
                                "const": "latest"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
