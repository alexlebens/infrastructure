#!/usr/bin/env bash

set -euo pipefail

if [[ -z "${1:-}" ]]; then
  echo "Usage: $(basename "$0") <namespace>" >&2
  exit 1
fi

NAMESPACE="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve get-images and resource-capacity, preferring PATH then sibling scripts
GET_IMAGES="$(command -v get-images || echo "${SCRIPT_DIR}/get-images")"
RESOURCE_CAPACITY="$(command -v resource-capacity || echo "${SCRIPT_DIR}/resource-capacity")"

"${GET_IMAGES}" "${NAMESPACE}"
echo ""
"${RESOURCE_CAPACITY}" "${NAMESPACE}"
