#!/usr/bin/env bash
#MISE description="Inspect and cleanup failing CloudNativePG (CNPG) instance pods and PVCs in a namespace"
set -euo pipefail

# ==============================================================================
# CloudNativePG (CNPG) Local Instance Cleanup Utility
#
# Discovers CNPG instances in a given namespace, pairs each Pod with its
# associated PVCs and PVs, highlights failing/unhealthy instances, and allows
# selecting instance(s) to delete with a single confirmation request.
#
# When a CNPG instance Pod and PVCs are deleted, the CloudNativePG operator
# automatically reprovisions fresh PVCs and resynchronizes the instance.
# ==============================================================================

# ANSI Colors
BOLD=$(printf '\033[1m')
DIM=$(printf '\033[2m')
RESET=$(printf '\033[0m')
RED=$(printf '\033[1;31m')
GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
CYAN=$(printf '\033[1;36m')
GRAY=$(printf '\033[0;90m')

# Print usage
usage() {
    cat <<EOF
${BOLD}Usage:${RESET} $(basename "$0") [OPTIONS] [NAMESPACE]

${BOLD}Description:${RESET}
  Interactively inspect and cleanup failing CloudNativePG (CNPG) instance pods
  and their associated PVCs / PVs in a given namespace.

${BOLD}Arguments:${RESET}
  NAMESPACE                  Kubernetes namespace to target (prompted if omitted)

${BOLD}Options:${RESET}
  -n, --namespace <ns>       Target namespace
  -d, --dry-run              Preview actions without deleting any resources
  -h, --help                 Show this help message
EOF
    exit 0
}

# Dependency checks
check_dependencies() {
    local missing=()
    command -v kubectl &>/dev/null || missing+=("kubectl")
    command -v jq &>/dev/null || missing+=("jq")

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}Error:${RESET} Missing required dependencies: ${missing[*]}" >&2
        echo "Please install them and ensure they are in your PATH." >&2
        exit 1
    fi
}

# Parse CLI arguments
NAMESPACE=""
DRY_RUN=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--namespace)
            NAMESPACE="${2:-}"
            shift 2
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo -e "${RED}Error:${RESET} Unknown option: $1" >&2
            echo "Use --help for usage information." >&2
            exit 1
            ;;
        *)
            if [ -z "$NAMESPACE" ]; then
                NAMESPACE="$1"
            else
                echo -e "${RED}Error:${RESET} Unexpected argument: $1" >&2
                exit 1
            fi
            shift
            ;;
    esac
done

check_dependencies

# Prompt for namespace if not provided
if [ -z "$NAMESPACE" ]; then
    read -r -e -p "Enter namespace: " NAMESPACE
    NAMESPACE="$(echo "$NAMESPACE" | xargs)" # trim whitespace
    if [ -z "$NAMESPACE" ]; then
        echo -e "${RED}Error:${RESET} No namespace specified. Exiting." >&2
        exit 1
    fi
fi

if [ "$DRY_RUN" = true ]; then
    echo -e "${YELLOW}[DRY-RUN MODE ENABLED]${RESET} No resources will be deleted."
fi

echo -e "Querying CNPG resources in namespace '${BOLD}${CYAN}${NAMESPACE}${RESET}'..."

RAW_JSON=""
if [ -n "${MOCK_KUBECTL_JSON:-}" ] && [ -f "${MOCK_KUBECTL_JSON:-}" ]; then
    RAW_JSON=$(cat "$MOCK_KUBECTL_JSON")
else
    # Fetch pods and PVCs with cnpg.io/cluster label
    if ! RAW_JSON=$(kubectl get pods,pvc -n "$NAMESPACE" -l 'cnpg.io/cluster' -o json 2>/dev/null); then
        echo -e "${RED}Error:${RESET} Failed to query namespace '${NAMESPACE}'. Please check if the namespace exists and kubectl has cluster access." >&2
        exit 1
    fi

    ITEM_COUNT=$(echo "$RAW_JSON" | jq '.items | length')

    # Fallback: if no items found with cnpg.io/cluster selector, query all and filter postgres/cnpg
    if [ "$ITEM_COUNT" -eq 0 ]; then
        FALLBACK_JSON=$(kubectl get pods,pvc -n "$NAMESPACE" -o json 2>/dev/null || true)
        if [ -n "$FALLBACK_JSON" ]; then
            RAW_JSON=$(echo "$FALLBACK_JSON" | jq '
                .items |= [ .[] | select(
                    (.metadata.labels["cnpg.io/cluster"] != null) or
                    (.metadata.name | test("postgresql.*cluster|cnpg"; "i"))
                ) ]
            ')
        fi
    fi
fi

ITEM_COUNT=$(echo "$RAW_JSON" | jq '.items | length')
if [ "$ITEM_COUNT" -eq 0 ]; then
    echo -e "${YELLOW}No CNPG instances or PVCs found in namespace '${NAMESPACE}'.${RESET}"
    exit 0
fi

# Correlate Pods and PVCs into instances
PARSED_INSTANCES=$(echo "$RAW_JSON" | jq '
[ .items[] ] as $all |
(
  [
    $all[] |
    if .kind == "Pod" then
      .metadata.labels["cnpg.io/instanceName"] // .metadata.name
    elif .kind == "PersistentVolumeClaim" then
      .metadata.labels["cnpg.io/instanceName"] // (.metadata.name | sub("-wal$"; ""))
    else empty end
  ] | unique | sort
) as $instances |
[
  $instances[] |
  . as $inst |
  ([ $all[] | select(.kind == "Pod" and ((.metadata.labels["cnpg.io/instanceName"] // .metadata.name) == $inst)) ] | first) as $pod |
  [ $all[] | select(.kind == "PersistentVolumeClaim" and ((.metadata.labels["cnpg.io/instanceName"] // "") == $inst or (.metadata.name == $inst or .metadata.name == ($inst + "-wal")))) ] as $pvcs |
  (
    if $pod == null then "MissingPod"
    elif $pod.metadata.deletionTimestamp then "Terminating"
    elif ($pod.status.containerStatuses[]?.state.waiting.reason) then
      [$pod.status.containerStatuses[]?.state.waiting.reason][0]
    elif ($pod.status.containerStatuses[]?.state.terminated.reason) then
      [$pod.status.containerStatuses[]?.state.terminated.reason][0]
    else ($pod.status.phase // "Unknown")
    end
  ) as $status |
  (
    if $pod then
      ([$pod.status.containerStatuses[]? | select(.ready == true)] | length)
    else 0 end
  ) as $ready_count |
  (
    if $pod then
      ($pod.status.containerStatuses? | length // 0)
    else 0 end
  ) as $total_count |
  (
    ($pod == null) or
    ($status != "Running" and $status != "Completed") or
    ($total_count > 0 and $ready_count < $total_count) or
    ([$pvcs[] | select(.status.phase != "Bound")] | length > 0)
  ) as $is_failing |
  {
    instance: $inst,
    pod: ($pod.metadata.name // ""),
    cluster: ($pod.metadata.labels["cnpg.io/cluster"] // ($pvcs[0].metadata.labels["cnpg.io/cluster"] // "unknown")),
    status: $status,
    ready: "\($ready_count)/\($total_count)",
    restarts: ([$pod.status.containerStatuses[]?.restartCount // 0] | add // 0),
    is_failing: $is_failing,
    pvcs: [
      $pvcs[] | {
        name: .metadata.name,
        pv: (.spec.volumeName // "None"),
        status: (.status.phase // "Unknown"),
        size: (.spec.resources.requests.storage // "-"),
        storage_class: (.spec.storageClassName // "-")
      }
    ]
  }
]
')

TOTAL_INSTANCES=$(echo "$PARSED_INSTANCES" | jq 'length')

if [ "$TOTAL_INSTANCES" -eq 0 ]; then
    echo -e "${YELLOW}No CNPG instance pairs found in namespace '${NAMESPACE}'.${RESET}"
    exit 0
fi

echo ""
echo -e "${BOLD}Found ${TOTAL_INSTANCES} CNPG instance(s) in namespace '${CYAN}${NAMESPACE}${RESET}':"
echo ""

FAILING_INDICES=()

for ((i=0; i<TOTAL_INSTANCES; i++)); do
    NUM=$((i+1))
    ENTRY=$(echo "$PARSED_INSTANCES" | jq -r ".[$i]")
    INSTANCE=$(echo "$ENTRY" | jq -r '.instance')
    POD=$(echo "$ENTRY" | jq -r '.pod')
    CLUSTER=$(echo "$ENTRY" | jq -r '.cluster')
    STATUS=$(echo "$ENTRY" | jq -r '.status')
    READY=$(echo "$ENTRY" | jq -r '.ready')
    RESTARTS=$(echo "$ENTRY" | jq -r '.restarts')
    IS_FAILING=$(echo "$ENTRY" | jq -r '.is_failing')

    if [ "$IS_FAILING" = "true" ]; then
        FAILING_INDICES+=("$NUM")
        BADGE="${RED}[FAIL]${RESET}"
        NUM_PREFIX="${RED}* [${NUM}]${RESET}"
        NAME_DISPLAY="${RED}${BOLD}${INSTANCE}${RESET}"
    else
        BADGE="${GREEN}[OK]${RESET}"
        NUM_PREFIX="  [${NUM}]"
        NAME_DISPLAY="${BOLD}${INSTANCE}${RESET}"
    fi

    echo -e "${NUM_PREFIX} ${NAME_DISPLAY} ${BADGE} ${GRAY}(Cluster: ${CLUSTER})${RESET}"

    if [ -n "$POD" ]; then
        if [ "$IS_FAILING" = "true" ]; then
            echo -e "      Pod:  ${RED}${POD}${RESET} | Status: ${RED}${STATUS}${RESET} (${READY} ready, ${RESTARTS} restarts)"
        else
            echo -e "      Pod:  ${POD} | Status: ${GREEN}${STATUS}${RESET} (${READY} ready, ${RESTARTS} restarts)"
        fi
    else
        echo -e "      Pod:  ${YELLOW}(none - missing Pod)${RESET}"
    fi

    PVC_COUNT=$(echo "$ENTRY" | jq '.pvcs | length')
    if [ "$PVC_COUNT" -gt 0 ]; then
        for ((p=0; p<PVC_COUNT; p++)); do
            PVC_NAME=$(echo "$ENTRY" | jq -r ".pvcs[$p].name")
            PV_NAME=$(echo "$ENTRY" | jq -r ".pvcs[$p].pv")
            PVC_STATUS=$(echo "$ENTRY" | jq -r ".pvcs[$p].status")
            PVC_SIZE=$(echo "$ENTRY" | jq -r ".pvcs[$p].size")

            STATUS_COLOR="$GREEN"
            [ "$PVC_STATUS" != "Bound" ] && STATUS_COLOR="$RED"

            echo -e "      PVC:  ${CYAN}${PVC_NAME}${RESET} [${STATUS_COLOR}${PVC_STATUS}${RESET}, ${PVC_SIZE}] ──► PV: ${GRAY}${PV_NAME}${RESET}"
        done
    else
        echo -e "      PVC:  ${YELLOW}(none - missing PVC)${RESET}"
    fi
    echo ""
done

# Selection prompt
echo -e "${DIM}------------------------------------------------------------${RESET}"
if [ ${#FAILING_INDICES[@]} -gt 0 ]; then
    echo -e "Failing instance number(s): ${RED}${FAILING_INDICES[*]}${RESET}"
    PROMPT_MSG="Select number(s) to delete (e.g. ${FAILING_INDICES[0]}, 'f' for all failing, 'q' to quit): "
else
    echo -e "${GREEN}All instances appear healthy.${RESET}"
    PROMPT_MSG="Select number(s) to delete (or 'q' to quit): "
fi

read -r -e -p "$PROMPT_MSG" USER_SELECTION
USER_SELECTION="$(echo "$USER_SELECTION" | xargs)"

if [[ -z "$USER_SELECTION" || "$USER_SELECTION" =~ ^[qQ](uit)?$ ]]; then
    echo "No instances selected. Exiting."
    exit 0
fi

# Parse selected indices
SELECTED_INDICES=()
if [[ "$USER_SELECTION" =~ ^[fF](ailed)?$ ]]; then
    if [ ${#FAILING_INDICES[@]} -eq 0 ]; then
        echo -e "${YELLOW}No failing instances found to delete. Exiting.${RESET}"
        exit 0
    fi
    SELECTED_INDICES=("${FAILING_INDICES[@]}")
else
    for item in ${USER_SELECTION//,/ }; do
        if [[ "$item" =~ ^[0-9]+$ ]] && (( item >= 1 && item <= TOTAL_INSTANCES )); then
            SELECTED_INDICES+=("$item")
        else
            echo -e "${RED}Error:${RESET} Invalid selection '$item'. Must be a number between 1 and ${TOTAL_INSTANCES}." >&2
            exit 1
        fi
    done
fi

# Deduplicate selections
mapfile -t UNIQUE_INDICES < <(printf "%s\n" "${SELECTED_INDICES[@]}" | sort -nu)

# Build list of resources to delete
PODS_TO_DELETE=()
PVCS_TO_DELETE=()

echo ""
echo -e "${BOLD}${RED}The following resources will be DELETED from namespace '${NAMESPACE}':${RESET}"
echo -e "${DIM}============================================================${RESET}"

for idx in "${UNIQUE_INDICES[@]}"; do
    array_idx=$((idx-1))
    ENTRY=$(echo "$PARSED_INSTANCES" | jq -r ".[$array_idx]")
    INSTANCE=$(echo "$ENTRY" | jq -r '.instance')
    POD=$(echo "$ENTRY" | jq -r '.pod')

    echo -e "  • ${BOLD}Instance:${RESET} ${CYAN}${INSTANCE}${RESET}"
    if [ -n "$POD" ]; then
        echo -e "    - Pod:  ${RED}${POD}${RESET}"
        PODS_TO_DELETE+=("$POD")
    fi

    PVC_COUNT=$(echo "$ENTRY" | jq '.pvcs | length')
    for ((p=0; p<PVC_COUNT; p++)); do
        PVC_NAME=$(echo "$ENTRY" | jq -r ".pvcs[$p].name")
        PV_NAME=$(echo "$ENTRY" | jq -r ".pvcs[$p].pv")
        echo -e "    - PVC:  ${YELLOW}${PVC_NAME}${RESET} ${GRAY}(PV: ${PV_NAME})${RESET}"
        PVCS_TO_DELETE+=("$PVC_NAME")
    done
done
echo -e "${DIM}============================================================${RESET}"
echo ""

# Single confirmation request
read -r -p "Are you sure you want to delete these resources? (y/N): " CONFIRMATION
if [[ ! "$CONFIRMATION" =~ ^[yY](es)?$ ]]; then
    echo "Deletion cancelled by user. Exiting."
    exit 0
fi

if [ "$DRY_RUN" = true ]; then
    echo -e "${YELLOW}[DRY-RUN]${RESET} Skipping actual deletion."
    exit 0
fi

echo ""
echo -e "${BOLD}Executing deletion in namespace '${NAMESPACE}'...${RESET}"

# Delete Pods
if [ ${#PODS_TO_DELETE[@]} -gt 0 ]; then
    for pod in "${PODS_TO_DELETE[@]}"; do
        echo -e "Deleting Pod: ${BOLD}${pod}${RESET}"
        if kubectl delete pod "$pod" -n "$NAMESPACE" --wait=false; then
            echo -e "  ${GREEN}✔ Deleted Pod: ${pod}${RESET}"
        else
            echo -e "  ${RED}✖ Failed to delete Pod: ${pod}${RESET}" >&2
        fi
    done
fi

# Delete PVCs
if [ ${#PVCS_TO_DELETE[@]} -gt 0 ]; then
    for pvc in "${PVCS_TO_DELETE[@]}"; do
        echo -e "Deleting PVC: ${BOLD}${pvc}${RESET}"
        if kubectl delete pvc "$pvc" -n "$NAMESPACE" --wait=false; then
            echo -e "  ${GREEN}✔ Deleted PVC: ${pvc}${RESET}"
        else
            echo -e "  ${RED}✖ Failed to delete PVC: ${pvc}${RESET}" >&2
        fi
    done
fi

echo ""
echo -e "${GREEN}${BOLD}Cleanup completed successfully.${RESET}"
echo -e "${GRAY}Note: CloudNativePG operator will automatically recreate the instance and storage.${RESET}"
