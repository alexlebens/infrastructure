#!/usr/bin/env bash
#MISE description="Scan and remediate failing CloudNativePG standby instances"
set -euo pipefail

# ==============================================================================
# CloudNativePG (CNPG) Standby Auto-Remediator CLI
#
# Inspects CloudNativePG clusters across the cluster (or within a namespace),
# detects failing standby instances with corrupted/broken PVCs, validates
# safety guardrails (never touches primary, ensures primary health, quorum,
# and cooldowns), and safely remediates them by deleting the pod and PVCs.
# ==============================================================================

# ANSI Colors
BOLD=$(printf '\033[1m')
RESET=$(printf '\033[0m')
RED=$(printf '\033[1;31m')
GREEN=$(printf '\033[1;32m')
YELLOW=$(printf '\033[1;33m')
CYAN=$(printf '\033[1;36m')
GRAY=$(printf '\033[0;90m')

MIN_RESTARTS="${MIN_RESTARTS:-5}"
COOLDOWN_SECONDS="${COOLDOWN_SECONDS:-3600}"
MAX_CLUSTERS="${MAX_CLUSTERS:-2}"
DRY_RUN=false
TARGET_NAMESPACE=""

usage() {
    cat <<EOF
${BOLD}Usage:${RESET} $(basename "$0") [OPTIONS]

${BOLD}Description:${RESET}
  Scan CNPG clusters for failing standby instances and automatically remediate
  them using strict safety guardrails.

${BOLD}Options:${RESET}
  -n, --namespace <ns>       Scan only a specific namespace (default: all namespaces)
  -r, --min-restarts <n>     Minimum restart count required to remediate (default: 5)
  -c, --cooldown <sec>       Cooldown window in seconds per cluster (default: 3600)
  -m, --max-clusters <n>     Max clusters to remediate per run (default: 2)
  -d, --dry-run              Report actions without deleting any resources
  -h, --help                 Show this help message
EOF
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--namespace)
            TARGET_NAMESPACE="${2:-}"
            shift 2
            ;;
        -r|--min-restarts)
            MIN_RESTARTS="${2:-5}"
            shift 2
            ;;
        -c|--cooldown)
            COOLDOWN_SECONDS="${2:-3600}"
            shift 2
            ;;
        -m|--max-clusters)
            MAX_CLUSTERS="${2:-1}"
            shift 2
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo -e "${RED}Error:${RESET} Unknown option: $1" >&2
            exit 1
            ;;
    esac
done

command -v kubectl &>/dev/null || { echo -e "${RED}Error:${RESET} kubectl is required." >&2; exit 1; }
command -v jq &>/dev/null || { echo -e "${RED}Error:${RESET} jq is required." >&2; exit 1; }

parse_iso_to_epoch() {
    local iso="$1"
    if date --version &>/dev/null || date -d "@0" &>/dev/null; then
        date -d "$iso" +%s 2>/dev/null || echo 0
    else
        date -j -f "%Y-%m-%dT%H:%M:%SZ" "$iso" "+%s" 2>/dev/null || echo 0
    fi
}

check_etcd_and_cluster_health() {
    echo -e "Checking Kubernetes cluster health and etcd quorum..."

    # Check 1: API Server health and etcd status via /readyz?verbose
    local readyz_verbose
    readyz_verbose=$(kubectl get --raw='/readyz?verbose' 2>/dev/null || true)

    if [ -n "$readyz_verbose" ]; then
        if echo "$readyz_verbose" | grep -q "[-]etcd"; then
            echo -e "  ${RED}✖ [ABORT]${RESET} etcd health check failed in /readyz. Aborting remediation." >&2
            return 1
        fi
        if ! echo "$readyz_verbose" | grep -qE "\[\+\]etcd(-readiness)? ok"; then
            echo -e "  ${RED}✖ [ABORT]${RESET} etcd readiness was not confirmed in /readyz. Aborting remediation." >&2
            return 1
        fi
        echo -e "  ${GREEN}✔${RESET} API Server reports etcd is healthy and ready."
    else
        # Fallback to simple /readyz
        local readyz
        readyz=$(kubectl get --raw='/readyz' 2>/dev/null || true)
        if [ "$readyz" != "ok" ]; then
            echo -e "  ${RED}✖ [ABORT]${RESET} Kubernetes /readyz check failed ('$readyz'). Aborting remediation." >&2
            return 1
        fi
        echo -e "  ${GREEN}✔${RESET} Kubernetes /readyz check passed."
    fi

    # Check 2: Control plane nodes quorum
    local nodes_json
    nodes_json=$(kubectl get nodes -l 'node-role.kubernetes.io/control-plane' -o json 2>/dev/null || true)

    if [ -n "$nodes_json" ]; then
        local total_cp ready_cp required_quorum
        total_cp=$(echo "$nodes_json" | jq '.items | length // 0')
        if [ "$total_cp" -gt 0 ]; then
            ready_cp=$(echo "$nodes_json" | jq '[.items[] | select(.status.conditions[]? | select(.type == "Ready" and .status == "True"))] | length')
            required_quorum=$(( (total_cp / 2) + 1 ))

            echo -e "  Control plane nodes: ${ready_cp}/${total_cp} Ready (Quorum requires: ${required_quorum})"

            if [ "$ready_cp" -lt "$required_quorum" ]; then
                echo -e "  ${RED}✖ [ABORT]${RESET} Control plane has lost etcd quorum (${ready_cp}/${total_cp} Ready). Aborting remediation." >&2
                return 1
            fi
            echo -e "  ${GREEN}✔${RESET} Control plane quorum is healthy (${ready_cp}/${total_cp} Ready)."
        fi
    fi

    return 0
}

echo -e "${BOLD}==========================================================${RESET}"
echo -e "${BOLD}CloudNativePG Standby Auto-Remediator${RESET}"
echo -e "Started at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo -e "Config: ${CYAN}MIN_RESTARTS=${MIN_RESTARTS}${RESET}, ${CYAN}COOLDOWN=${COOLDOWN_SECONDS}s${RESET}, ${CYAN}DRY_RUN=${DRY_RUN}${RESET}"
[ -n "$TARGET_NAMESPACE" ] && echo -e "Namespace filter: ${YELLOW}${TARGET_NAMESPACE}${RESET}"
echo -e "${BOLD}==========================================================${RESET}"

if ! check_etcd_and_cluster_health; then
    echo -e "${RED}Cluster health check failed. Exiting immediately to prevent remediation during cluster degradation.${RESET}" >&2
    exit 1
fi
echo ""

KUBECTL_CLUSTER_ARGS=("-A")
[ -n "$TARGET_NAMESPACE" ] && KUBECTL_CLUSTER_ARGS=("-n" "$TARGET_NAMESPACE")

CLUSTERS_JSON=$(kubectl get clusters.postgresql.cnpg.io "${KUBECTL_CLUSTER_ARGS[@]}" -o json 2>/dev/null || true)
if [ -z "$CLUSTERS_JSON" ] || [ "$(echo "$CLUSTERS_JSON" | jq '.items | length')" -eq 0 ]; then
    echo -e "${YELLOW}No CNPG clusters found matching criteria.${RESET}"
    exit 0
fi

TOTAL_CLUSTERS=$(echo "$CLUSTERS_JSON" | jq '.items | length')
echo -e "Discovered ${BOLD}${TOTAL_CLUSTERS}${RESET} CNPG cluster(s)."
echo ""

REMEDIATED_COUNT=0
while read -r cluster; do
    NS=$(echo "$cluster" | jq -r '.metadata.namespace')
    NAME=$(echo "$cluster" | jq -r '.metadata.name')
    PHASE=$(echo "$cluster" | jq -r '.status.phase // "Unknown"')
    PRIMARY=$(echo "$cluster" | jq -r '.status.currentPrimary // ""')
    LAST_REMEDIATED=$(echo "$cluster" | jq -r '.metadata.annotations["cnpg.io/last-remediated-at"] // ""')

    echo -e "${BOLD}--- Cluster: ${CYAN}${NS}/${NAME}${RESET} ${GRAY}(Phase: ${PHASE}, Primary: ${PRIMARY})${RESET} ---"

    # Safety Check 1: Primary exists
    if [ -z "$PRIMARY" ]; then
        echo -e "  ${YELLOW}[SKIP]${RESET} No current primary reported. Skipping cluster to avoid split-brain."
        continue
    fi

    # Safety Check 2: Primary is healthy
    PRIMARY_POD_JSON=$(kubectl get pod "$PRIMARY" -n "$NS" -o json 2>/dev/null || true)
    if [ -z "$PRIMARY_POD_JSON" ]; then
        echo -e "  ${RED}[ABORT]${RESET} Primary pod '${PRIMARY}' not found in namespace '${NS}'. Skipping."
        continue
    fi
    PRIMARY_READY=$(echo "$PRIMARY_POD_JSON" | jq -r '([.status.containerStatuses[]? | select(.ready == true)] | length) == (.status.containerStatuses? | length // 0)')
    PRIMARY_PHASE=$(echo "$PRIMARY_POD_JSON" | jq -r '.status.phase // ""')
    if [ "$PRIMARY_READY" != "true" ] || [ "$PRIMARY_PHASE" != "Running" ]; then
        echo -e "  ${RED}[ABORT]${RESET} Primary pod '${PRIMARY}' is unhealthy (Phase: ${PRIMARY_PHASE}, Ready: ${PRIMARY_READY}). Skipping."
        continue
    fi

    # Safety Check 3: Cooldown / Flap protection
    if [ -n "$LAST_REMEDIATED" ]; then
        LAST_SEC=$(parse_iso_to_epoch "$LAST_REMEDIATED")
        NOW_SEC=$(date "+%s")
        DIFF=$((NOW_SEC - LAST_SEC))
        if [ "$DIFF" -lt "$COOLDOWN_SECONDS" ]; then
            REMAINING=$((COOLDOWN_SECONDS - DIFF))
            echo -e "  ${GRAY}[COOLDOWN]${RESET} Cluster remediated ${DIFF}s ago. ${REMAINING}s remaining in cooldown. Skipping."
            continue
        fi
    fi

    # Query instance pods
    PODS_JSON=$(kubectl get pods -n "$NS" -l "cnpg.io/cluster=${NAME},cnpg.io/podRole=instance" -o json 2>/dev/null || true)
    if [ -z "$PODS_JSON" ]; then
        echo -e "  No instance pods found for cluster."
        continue
    fi

    # Find failing standbys
    STANDBYS=$(echo "$PODS_JSON" | jq -c --arg p "$PRIMARY" --argjson min "$MIN_RESTARTS" '
        [ .items[] | select(.metadata.name != $p) ] |
        [ .[] |
          . as $pod |
          (if $pod.metadata.deletionTimestamp then "Terminating"
           elif ($pod.status.containerStatuses[]?.state.waiting.reason) then
             [$pod.status.containerStatuses[]?.state.waiting.reason][0]
           elif ($pod.status.containerStatuses[]?.state.terminated.reason) then
             [$pod.status.containerStatuses[]?.state.terminated.reason][0]
           else ($pod.status.phase // "Unknown") end
          ) as $status |
          ([$pod.status.containerStatuses[]?.restartCount // 0] | add // 0) as $restarts |
          ([$pod.status.containerStatuses[]? | select(.ready == true)] | length) as $ready_count |
          ($pod.status.containerStatuses? | length // 0) as $total_count |
          select(
            ($status != "Running" and $status != "Completed") or
            ($ready_count < $total_count and $restarts >= $min) or
            ($restarts >= $min and ($status == "CrashLoopBackOff" or $status == "Error"))
          ) |
          {
            name: $pod.metadata.name,
            status: $status,
            ready: "\($ready_count)/\($total_count)",
            restarts: $restarts
          }
        ] | sort_by(-.restarts)
    ')

    FAILING_COUNT=$(echo "$STANDBYS" | jq 'length')
    if [ "$FAILING_COUNT" -eq 0 ]; then
        echo -e "  ${GREEN}✔${RESET} All standby instances appear healthy."
        continue
    fi

    TARGET_STANDBY=$(echo "$STANDBYS" | jq -r '.[0].name')
    TARGET_STATUS=$(echo "$STANDBYS" | jq -r '.[0].status')
    TARGET_RESTARTS=$(echo "$STANDBYS" | jq -r '.[0].restarts')
    TARGET_READY=$(echo "$STANDBYS" | jq -r '.[0].ready')

    echo -e "  ${RED}✖ [TARGET]${RESET} Found failing standby: ${RED}${TARGET_STANDBY}${RESET} (Status: ${TARGET_STATUS}, Ready: ${TARGET_READY}, Restarts: ${TARGET_RESTARTS})"

    PVCS_JSON=$(kubectl get pvc -n "$NS" -l "cnpg.io/cluster=${NAME}" -o json 2>/dev/null || true)
    TARGET_PVCS=()
    if [ -n "$PVCS_JSON" ]; then
        readarray -t TARGET_PVCS < <(echo "$PVCS_JSON" | jq -r --arg inst "$TARGET_STANDBY" '
            [ .items[] | select(.metadata.labels["cnpg.io/instanceName"] == $inst or .metadata.name == $inst or .metadata.name == ($inst + "-wal")) | .metadata.name ] | .[]
        ')
    fi

    echo -e "  Associated PVCs: ${CYAN}${TARGET_PVCS[*]:-(none)}${RESET}"

    if [ "$DRY_RUN" = "true" ]; then
        echo -e "  ${YELLOW}[DRY-RUN]${RESET} Would delete Pod '${TARGET_STANDBY}' and PVCs: ${TARGET_PVCS[*]:-}"
    else
        echo -e "  ${BOLD}Executing auto-remediation...${RESET}"
        echo -e "  Deleting Pod: ${TARGET_STANDBY}"
        kubectl delete pod "$TARGET_STANDBY" -n "$NS" --wait=false || true

        if [ ${#TARGET_PVCS[@]} -gt 0 ]; then
            for pvc in "${TARGET_PVCS[@]}"; do
                echo -e "  Deleting PVC: ${pvc}"
                kubectl delete pvc "$pvc" -n "$NS" --wait=false || true
            done
        fi

        TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        kubectl annotate cluster "$NAME" -n "$NS" "cnpg.io/last-remediated-at=${TIMESTAMP}" --overwrite || true
        echo -e "  ${GREEN}✔ [REMEDIATED]${RESET} Standby ${TARGET_STANDBY} cleaned up. CloudNativePG will reprovision."
    fi

    REMEDIATED_COUNT=$((REMEDIATED_COUNT + 1))
    echo ""

    if [ "$MAX_CLUSTERS" -gt 0 ] && [ "$REMEDIATED_COUNT" -ge "$MAX_CLUSTERS" ]; then
        echo -e "${YELLOW}Reached maximum clusters to remediate per run limit (${MAX_CLUSTERS}). Stopping execution.${RESET}"
        break
    fi
done < <(echo "$CLUSTERS_JSON" | jq -c '.items[]')

echo -e "${BOLD}==========================================================${RESET}"
echo -e "Finished run at: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo -e "${BOLD}==========================================================${RESET}"
