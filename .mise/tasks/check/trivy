#!/usr/bin/env bash
#MISE description="Scan rendered Helm chart manifests with Trivy for security misconfigurations"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/log.sh
source "${REPO_ROOT}/.mise/lib/log.sh"

CHART="${CHART:-}"
CLUSTER="${CLUSTER:-cl01tl}"
MANIFEST_PATH="${MANIFEST_PATH:-}"
FAIL_ON="${FAIL_ON:-ANY}"
GITEA_TOKEN="${GITEA_TOKEN:-}"
PR_NUMBER="${PR_NUMBER:-}"
MAIN_DIR="${MAIN_DIR:-${REPO_ROOT}}"
IGNORE_FILE="${IGNORE_FILE:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --chart)
      CHART="$2"
      shift 2
      ;;
    --cluster)
      CLUSTER="$2"
      shift 2
      ;;
    --main-dir)
      MAIN_DIR="$2"
      shift 2
      ;;
    --manifest|--manifest-path|--manifest-dir)
      MANIFEST_PATH="$2"
      shift 2
      ;;
    --ignorefile)
      IGNORE_FILE="$2"
      shift 2
      ;;
    --fail-on)
      FAIL_ON="$2"
      shift 2
      ;;
    --gitea-token)
      GITEA_TOKEN="$2"
      shift 2
      ;;
    --pr-number)
      PR_NUMBER="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: mise run check:trivy [--chart <chart>] [--cluster <cluster>] [--main-dir <dir>] [--manifest <file|dir>] [--ignorefile <file>] [--fail-on <ANY|CRITICAL|HIGH>] [--gitea-token <token>] [--pr-number <num>]"
      echo "Runs Trivy misconfiguration scan on rendered manifests, publishes advisory summary and PR comments, and enforces severity gate."
      exit 0
      ;;
    *)
      if [ -z "${CHART}" ] && [[ "$1" != -* ]]; then
        CHART="$1"
        shift
      else
        log_fatal "Unknown argument: $1"
      fi
      ;;
  esac
done

if [ -z "${CHART}" ] && [ -z "${MANIFEST_PATH}" ]; then
  log_fatal "Error: --chart (or CHART env var) or --manifest is required."
fi

# Normalize chart name if full/relative path passed
if [ -n "${CHART}" ]; then
  CHART="$(basename "${CHART}")"
fi

if [ -z "${MANIFEST_PATH}" ]; then
  MANIFEST_PATH="${MAIN_DIR}/clusters/${CLUSTER}/manifests/${CHART}"
fi

if [ ! -e "${MANIFEST_PATH}" ]; then
  log_fatal "Error: Manifest path '${MANIFEST_PATH}' not found."
fi

REPORT_JSON="$(mktemp)"
COMBINED_IGNORE=""

cleanup() {
  rm -f "${REPORT_JSON:-}" "${COMBINED_IGNORE:-}"
}
trap cleanup EXIT

# Detect and combine ignore files if not explicitly set
if [ -z "${IGNORE_FILE}" ]; then
  CHART_IGNORE="${MAIN_DIR}/clusters/${CLUSTER}/helm/${CHART:-}/.trivyignore"
  GLOBAL_IGNORE="${MAIN_DIR}/.trivyignore"

  if [ -f "${GLOBAL_IGNORE}" ] && [ -n "${CHART}" ] && [ -f "${CHART_IGNORE}" ]; then
    COMBINED_IGNORE="$(mktemp)"
    cat "${GLOBAL_IGNORE}" "${CHART_IGNORE}" > "${COMBINED_IGNORE}"
    IGNORE_FILE="${COMBINED_IGNORE}"
  elif [ -n "${CHART}" ] && [ -f "${CHART_IGNORE}" ]; then
    IGNORE_FILE="${CHART_IGNORE}"
  elif [ -f "${GLOBAL_IGNORE}" ]; then
    IGNORE_FILE="${GLOBAL_IGNORE}"
  fi
fi

log_step "Running Trivy scan for: ${CHART:-$(basename "${MANIFEST_PATH}")}"

# Generate machine-readable JSON in a single pass
if [ -n "${IGNORE_FILE}" ] && [ -f "${IGNORE_FILE}" ]; then
  log_info "Using ignore file: ${IGNORE_FILE}"
  trivy config --ignorefile "${IGNORE_FILE}" "${MANIFEST_PATH}" --format json > "${REPORT_JSON}" 2>/dev/null || true
else
  trivy config "${MANIFEST_PATH}" --format json > "${REPORT_JSON}" 2>/dev/null || true
fi

# Parse findings from JSON report in a single pass
read -r CRITICAL_COUNT HIGH_COUNT MEDIUM_COUNT LOW_COUNT < <(jq -r '
  [.Results[]?.Misconfigurations[]?] as $m |
  [
    ($m | map(select(.Severity == "CRITICAL")) | length),
    ($m | map(select(.Severity == "HIGH")) | length),
    ($m | map(select(.Severity == "MEDIUM")) | length),
    ($m | map(select(.Severity == "LOW")) | length)
  ] | @tsv' "${REPORT_JSON}" 2>/dev/null || echo "0 0 0 0")
TOTAL_FINDINGS=$(( CRITICAL_COUNT + HIGH_COUNT + MEDIUM_COUNT + LOW_COUNT ))

log_info "Summary for ${CHART:-$(basename "${MANIFEST_PATH}")}: ${CRITICAL_COUNT} Critical, ${HIGH_COUNT} High, ${MEDIUM_COUNT} Medium, ${LOW_COUNT} Low (${TOTAL_FINDINGS} total)"

if [ "${TOTAL_FINDINGS}" -gt 0 ]; then
  log_warn "Misconfigurations detected:"
  jq -r '.Results[]?.Misconfigurations[]? | "  - [\(.Severity)] \(.ID): \(.Title // .Message)"' "${REPORT_JSON}" 2>/dev/null || true
fi

# Build Markdown Report
TAG="<!-- trivy-scan-${CHART:-$(basename "${MANIFEST_PATH}")} -->"
MARKDOWN_REPORT="${TAG}
### Trivy Security Scan: \`${CHART:-$(basename "${MANIFEST_PATH}")}\`"

if [ "${TOTAL_FINDINGS}" -eq 0 ]; then
  STATUS_TEXT="**Passed** — No security misconfigurations detected."
  MARKDOWN_REPORT="${MARKDOWN_REPORT}
${STATUS_TEXT}"
else
  if [ "${FAIL_ON}" = "ANY" ] || [ "${FAIL_ON}" = "ALL" ]; then
    STATUS_TEXT="**Failed Gate** — Found ${TOTAL_FINDINGS} misconfiguration(s) requiring resolution."
  elif [ "${CRITICAL_COUNT}" -gt 0 ]; then
    STATUS_TEXT="**Failed Gate** — Found ${CRITICAL_COUNT} Critical misconfiguration(s) requiring resolution."
  elif [ "${FAIL_ON}" = "HIGH" ] && [ $(( CRITICAL_COUNT + HIGH_COUNT )) -gt 0 ]; then
    STATUS_TEXT="**Failed Gate** — Found $(( CRITICAL_COUNT + HIGH_COUNT )) High/Critical misconfiguration(s) requiring resolution."
  else
    STATUS_TEXT="**Passed Gate with Advisories** (0 Critical, ${HIGH_COUNT} High, ${MEDIUM_COUNT} Medium, ${LOW_COUNT} Low)"
  fi

  TABLE_ROWS=$(jq -r '
    [
      .Results[]? as $r |
      ($r.Misconfigurations // [])[]? |
      {
        target: ($r.Target // .Title // "manifest"),
        misconfig: .
      }
    ]
    | sort_by(
        (if .misconfig.Severity == "CRITICAL" then 0
         elif .misconfig.Severity == "HIGH" then 1
         elif .misconfig.Severity == "MEDIUM" then 2
         elif .misconfig.Severity == "LOW" then 3
         else 4 end),
        .target,
        .misconfig.ID
      )
    | map(
        .misconfig as $m |
        "| " +
        (if $m.Severity == "CRITICAL" then "🔴 **CRITICAL**"
         elif $m.Severity == "HIGH" then "🟠 **HIGH**"
         elif $m.Severity == "MEDIUM" then "🟡 **MEDIUM**"
         else "⚪ " + $m.Severity end) +
        " | [`" + $m.ID + "`](" + ($m.PrimaryURL // ("https://avd.aquasec.com/appshield/" + ($m.ID | ascii_downcase))) + ") | `" +
        .target + "` | " +
        (($m.Title // $m.Message // "") | gsub("\r?\n"; " ") | gsub("\\|"; "/")) + " |"
      )
    | join("\n")
  ' "${REPORT_JSON}" 2>/dev/null || true)

  MARKDOWN_REPORT="${MARKDOWN_REPORT}
${STATUS_TEXT}

| Severity | Rule ID | Resource | Message |
| :--- | :--- | :--- | :--- |
${TABLE_ROWS}"
fi

# Publish to Action UI Summary
if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
  echo "" >> "${GITHUB_STEP_SUMMARY}"
  echo "${MARKDOWN_REPORT}" >> "${GITHUB_STEP_SUMMARY}"
fi

# Publish to Gitea PR Comment
SERVER_URL="${PUBLIC_URL:-${GITHUB_SERVER_URL:-${GITEA_SERVER_URL:-}}}"
REPO="${GITHUB_REPOSITORY:-${GITEA_REPOSITORY:-}}"

if [ -n "${GITEA_TOKEN}" ] && [ -n "${PR_NUMBER}" ] && [ -n "${SERVER_URL}" ] && [ -n "${REPO}" ]; then
  log_info "Publishing Trivy advisory to PR #${PR_NUMBER} ..."
  if [ -f "${REPO_ROOT}/.gitea/scripts/helper_pr-comment-upsert.sh" ]; then
    # shellcheck source=../../../.gitea/scripts/helper_pr-comment-upsert.sh
    source "${REPO_ROOT}/.gitea/scripts/helper_pr-comment-upsert.sh"
    upsert_pr_comment "${TAG}" "${MARKDOWN_REPORT}"
  fi
fi

# Severity Gate Check
if [ "${FAIL_ON}" = "ANY" ] || [ "${FAIL_ON}" = "ALL" ]; then
  if [ "${TOTAL_FINDINGS}" -gt 0 ]; then
    log_fatal "Security check failed: ${TOTAL_FINDINGS} misconfiguration(s) detected in ${CHART:-$(basename "${MANIFEST_PATH}")} (${CRITICAL_COUNT} Critical, ${HIGH_COUNT} High, ${MEDIUM_COUNT} Medium, ${LOW_COUNT} Low)."
  fi
elif [ "${FAIL_ON}" = "CRITICAL" ] && [ "${CRITICAL_COUNT}" -gt 0 ]; then
  log_fatal "Security check failed: ${CRITICAL_COUNT} CRITICAL misconfiguration(s) detected in ${CHART:-$(basename "${MANIFEST_PATH}")}."
elif [ "${FAIL_ON}" = "HIGH" ] && [ $(( CRITICAL_COUNT + HIGH_COUNT )) -gt 0 ]; then
  log_fatal "Security check failed: $(( CRITICAL_COUNT + HIGH_COUNT )) HIGH/CRITICAL misconfiguration(s) detected in ${CHART:-$(basename "${MANIFEST_PATH}")}."
fi

log_success "Trivy scan passed gate for ${CHART:-$(basename "${MANIFEST_PATH}")}."
