#!/usr/bin/env bash
#MISE description="Validate rendered Kubernetes manifests using kubeconform"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/log.sh
source "${REPO_ROOT}/.mise/lib/log.sh"

CHART="${CHART:-}"
CLUSTER="${CLUSTER:-cl01tl}"
MANIFEST_PATH="${MANIFEST_PATH:-}"
KUBERNETES_VERSION="${KUBERNETES_VERSION:-}"
IGNORE_MISSING_SCHEMAS="${IGNORE_MISSING_SCHEMAS:-true}"
STRICT="${STRICT:-false}"
MAIN_DIR="${MAIN_DIR:-${REPO_ROOT}}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --chart)
      CHART="$2"
      shift 2
      ;;
    --cluster)
      CLUSTER="$2"
      shift 2
      ;;
    --main-dir)
      MAIN_DIR="$2"
      shift 2
      ;;
    --manifest|--manifest-path|--manifest-dir)
      MANIFEST_PATH="$2"
      shift 2
      ;;
    --kubernetes-version)
      KUBERNETES_VERSION="$2"
      shift 2
      ;;
    --strict)
      STRICT=true
      shift
      ;;
    -h|--help)
      echo "Usage: mise run check:kubeconform [--chart <chart>] [--cluster <cluster>] [--main-dir <dir>] [--manifest <file|dir>] [--kubernetes-version <version>] [--strict]"
      echo "Validates rendered Kubernetes manifests using kubeconform."
      exit 0
      ;;
    *)
      if [ -z "${CHART}" ] && [[ "$1" != -* ]]; then
        CHART="$1"
        shift
      else
        log_fatal "Unknown argument: $1"
      fi
      ;;
  esac
done

if [ -z "${CHART}" ] && [ -z "${MANIFEST_PATH}" ]; then
  log_fatal "Error: --chart (or CHART env var) or --manifest is required."
fi

# Normalize chart name if full/relative path passed
if [ -n "${CHART}" ]; then
  CHART="$(basename "${CHART}")"
fi

if [ -z "${MANIFEST_PATH}" ]; then
  MANIFEST_PATH="${MAIN_DIR}/clusters/${CLUSTER}/manifests/${CHART}"
fi

if [ ! -e "${MANIFEST_PATH}" ]; then
  log_fatal "Error: Manifest path '${MANIFEST_PATH}' not found."
fi

log_step "Running kubeconform validation for: ${CHART:-$(basename "${MANIFEST_PATH}")}"

# Build kubeconform arguments
SCHEMA_DIR="${HOME}/.schemas"

KUBECONFORM_ARGS=(
  -summary
  -output text
  -schema-location default
  -schema-location "${SCHEMA_DIR}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json"
  -schema-location 'https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json'
)

if [ -n "${KUBERNETES_VERSION}" ]; then
  # Strip leading 'v' if present for kubeconform
  KUBECONFORM_ARGS+=(-kubernetes-version "${KUBERNETES_VERSION#v}")
fi

if [ "${IGNORE_MISSING_SCHEMAS}" = "true" ]; then
  KUBECONFORM_ARGS+=(-ignore-missing-schemas)
fi

if [ "${STRICT}" = "true" ]; then
  KUBECONFORM_ARGS+=(-strict)
fi

# Run kubeconform against the rendered manifests
if [ -d "${MANIFEST_PATH}" ]; then
  shopt -s nullglob
  MANIFEST_FILES=("${MANIFEST_PATH}"/*.yaml)
  shopt -u nullglob

  if [ ${#MANIFEST_FILES[@]} -eq 0 ]; then
    log_info "No manifest files found in ${MANIFEST_PATH}. Skipping validation."
    exit 0
  fi

  kubeconform "${KUBECONFORM_ARGS[@]}" "${MANIFEST_FILES[@]}"
else
  kubeconform "${KUBECONFORM_ARGS[@]}" "${MANIFEST_PATH}"
fi

log_success "kubeconform validation completed successfully."
