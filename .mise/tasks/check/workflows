#!/usr/bin/env bash
#MISE description="Validate Gitea Actions workflow YAML files with actionlint"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/log.sh
source "${REPO_ROOT}/.mise/lib/log.sh"

WORKFLOW_DIR="${REPO_ROOT}/.gitea/workflows"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  echo "Usage: mise run check:workflows"
  echo "Validates Gitea Actions workflows using actionlint."
  exit 0
fi

if [ ! -d "${WORKFLOW_DIR}" ]; then
  log_info "No workflow directory found at ${WORKFLOW_DIR}."
  exit 0
fi

log_step "Running actionlint on workflows in .gitea/workflows/"

shopt -s nullglob
workflows=("${WORKFLOW_DIR}"/*.yaml "${WORKFLOW_DIR}"/*.yml)
shopt -u nullglob

if [ ${#workflows[@]} -eq 0 ]; then
  log_info "No workflow files found."
  exit 0
fi

actionlint_args=(
  -ignore 'specifying action "builtin:checkout" in invalid format'
  -ignore 'undefined variable "gitea"'
)

if [ -f "${REPO_ROOT}/.github/actionlint.yaml" ]; then
  actionlint_args+=(-config-file "${REPO_ROOT}/.github/actionlint.yaml")
fi

actionlint "${actionlint_args[@]}" "${workflows[@]}"
log_success "All workflows passed actionlint!"
