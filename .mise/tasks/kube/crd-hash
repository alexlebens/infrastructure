#!/usr/bin/env bash
#MISE description="Calculate SHA256 hash of cluster CRD names and generations for cache busting"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/k8s.sh
source "${REPO_ROOT}/.mise/lib/k8s.sh"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: mise run kube:crd-hash"
      echo "Calculates a SHA256 hash of cluster CRD names and generations for cache busting."
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

GITHUB_OUTPUT="${GITHUB_OUTPUT:-}"

CRD_HASH=$(k8s_get_crd_hash)

echo ">> Cluster CRD Hash:"
echo "${CRD_HASH}"

echo ""
echo "----"

if [ -n "${GITHUB_OUTPUT}" ]; then
  echo "hash=${CRD_HASH}" >> "${GITHUB_OUTPUT}"
fi
