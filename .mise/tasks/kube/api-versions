#!/usr/bin/env bash
#MISE description="Fetch cluster API versions, kinds, and fingerprint formatted for Helm"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/k8s.sh
source "${REPO_ROOT}/.mise/lib/k8s.sh"

FINGERPRINT_ONLY=false
CACHE_FILE=""
INDEX_FILE="${K8S_OPENAPI_INDEX_FILE:-/tmp/k8s-openapi-v3-index.txt}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --fingerprint)
      FINGERPRINT_ONLY=true
      shift
      ;;
    --cache-file)
      CACHE_FILE="$2"
      shift 2
      ;;
    --index-file)
      INDEX_FILE="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: mise run kube:api-versions [--fingerprint] [--cache-file <path>] [--index-file <path>]"
      echo "Fetches Kubernetes cluster API versions and CRD kinds, outputting them formatted for Helm."
      echo "Options:"
      echo "  --fingerprint        Compute and output the cluster version and CRD fingerprint hash"
      echo "  --cache-file <path>  Read from cache file if present and non-empty, otherwise fetch and save to cache"
      echo "  --index-file <path>  Save or reuse the cluster OpenAPI v3 index file (default: /tmp/k8s-openapi-v3-index.txt)"
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

GITHUB_OUTPUT="${GITHUB_OUTPUT:-}"

if [ "${FINGERPRINT_ONLY}" = true ]; then
  echo ">> Computing cluster API and CRD fingerprint ..."
  rm -f "${INDEX_FILE}"
  FINGERPRINT=$(k8s_get_fingerprint "${INDEX_FILE}")
  echo ">> Cluster Fingerprint: ${FINGERPRINT}"
  if [ -n "${GITHUB_OUTPUT}" ]; then
    echo "fingerprint=${FINGERPRINT}" >> "${GITHUB_OUTPUT}"
  fi
  exit 0
fi

if [ -n "${CACHE_FILE}" ] && [ -f "${CACHE_FILE}" ] && [ -s "${CACHE_FILE}" ]; then
  echo ">> Using cached API versions from ${CACHE_FILE} ..."
  API_VERSIONS=$(cat "${CACHE_FILE}")
  echo ">> API Versions (cached):"
  echo "${API_VERSIONS}"
  echo ""
  echo "----"
  if [ -n "${GITHUB_OUTPUT}" ]; then
    echo "api-versions=${API_VERSIONS}" >> "${GITHUB_OUTPUT}"
  fi
  exit 0
fi

echo ">> Querying Kubernetes cluster API versions and CRD kinds ..."
API_VERSIONS=$(k8s_get_api_versions "${CACHE_FILE}")

if [ -n "${CACHE_FILE}" ]; then
  echo ">> Saved API versions to cache file: ${CACHE_FILE}"
fi

echo ">> API Versions:"
echo "${API_VERSIONS}"
echo ""
echo "----"

if [ -n "${GITHUB_OUTPUT}" ]; then
  echo "api-versions=${API_VERSIONS}" >> "${GITHUB_OUTPUT}"
fi
