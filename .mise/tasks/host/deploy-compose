#!/usr/bin/env bash
#MISE description="Deploy or update a Docker Compose stack on a remote host via SSH"
set -euo pipefail

TARGET_HOST="${TARGET_HOST:-}"
SSH_USER="${SSH_USER:-alex}"
SSH_PORT="${SSH_PORT:-22}"
SERVICE_PATH="${SERVICE_PATH:-}"
REPO_DIR="${REPO_DIR:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      TARGET_HOST="$2"
      shift 2
      ;;
    --service-path)
      SERVICE_PATH="$2"
      shift 2
      ;;
    --repo-dir)
      REPO_DIR="$2"
      shift 2
      ;;
    --user)
      SSH_USER="$2"
      shift 2
      ;;
    --port)
      SSH_PORT="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: mise run host:deploy-compose --host <target_host> --service-path <path> [--repo-dir <dir>] [--user <user>] [--port <port>]"
      echo "Deploys/updates a Docker Compose stack on a remote host via SSH."
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

if [[ -z "${TARGET_HOST}" ]]; then
  echo "Error: --host (or TARGET_HOST) is required." >&2
  exit 1
fi

if [[ -z "${REPO_DIR}" ]]; then
  echo "Error: --repo-dir (or REPO_DIR) is required." >&2
  exit 1
fi

if [[ -z "${SERVICE_PATH}" ]]; then
  echo "Error: --service-path (or SERVICE_PATH) is required." >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
REMOTE_SCRIPT="${REPO_ROOT}/.mise/lib/remote-deploy-compose.sh"

if [[ ! -f "${REMOTE_SCRIPT}" ]]; then
  echo "Error: Remote script not found at ${REMOTE_SCRIPT}." >&2
  exit 1
fi

echo ">> Connecting to ${SSH_USER}@${TARGET_HOST}:${SSH_PORT} to deploy ${SERVICE_PATH}..."

ssh -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=30 -p "${SSH_PORT}" "${SSH_USER}@${TARGET_HOST}" bash -s -- "${SERVICE_PATH}" "${REPO_DIR}" < "${REMOTE_SCRIPT}"

echo ">> Successfully deployed ${SERVICE_PATH} on ${TARGET_HOST}!"
