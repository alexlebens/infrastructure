#!/usr/bin/env bash
#MISE description="Build or update chart dependencies"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/helm.sh
source "${REPO_ROOT}/.mise/lib/helm.sh"

SKIP_REFRESH=true
REMAINING_ARGS=()

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      echo "Usage: mise run helm:dep [chart...] [--cluster <cluster>] [--charts <charts...>] [--skip-refresh|--no-skip-refresh]"
      echo "Builds or updates Helm chart dependencies."
      exit 0
      ;;
    --skip-refresh)
      SKIP_REFRESH=true
      ;;
    --no-skip-refresh)
      SKIP_REFRESH=false
      ;;
    *)
      REMAINING_ARGS+=("$arg")
      ;;
  esac
done

helm_init "${REMAINING_ARGS[@]}"

if [ ${#CHARTS[@]} -eq 0 ]; then
  log_info "No charts found to build dependencies for."
  exit 0
fi

log_step "Building dependencies for cluster ${CLUSTER}"
FAILED_CHARTS=()

EXTRA_FLAGS=()
if [ "${SKIP_REFRESH}" = true ]; then
  EXTRA_FLAGS+=(--skip-refresh)
fi

for C in "${CHARTS[@]}"; do
  C_PATH="${HELM_DIR}/${C}"

  if [ ! -d "${C_PATH}" ]; then
    log_error "Chart directory '${C_PATH}' not found."
    FAILED_CHARTS+=("${C}")
    continue
  fi

  log_step "Building dependencies [${C}]"
  if ! (helm dependency build "${C_PATH}" "${EXTRA_FLAGS[@]}" 2>/dev/null || helm dependency update "${C_PATH}" "${EXTRA_FLAGS[@]}" >/dev/null); then
    log_error "Failed to build dependencies for ${C}"
    FAILED_CHARTS+=("${C}")
    continue
  fi
done

log_divider
if [ ${#FAILED_CHARTS[@]} -gt 0 ]; then
  log_error "Dependency build failed for chart(s): ${FAILED_CHARTS[*]}"
  exit 1
fi

log_success "All chart dependencies built successfully."
