#!/usr/bin/env bash
#MISE description="Render Helm chart templates to individual manifest files"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/helm.sh
source "${REPO_ROOT}/.mise/lib/helm.sh"

MANIFEST_DIR="${MANIFEST_DIR:-${REPO_ROOT}}"
RENDER_ALL="${RENDER_ALL:-false}"
RENDER_DIR="${RENDER_DIR:-}"
API_VERSIONS="${API_VERSIONS:-}"
PARALLEL_JOBS="${PARALLEL_JOBS:-5}"
GITHUB_OUTPUT="${GITHUB_OUTPUT:-}"
SKIP_REPO_ADD=false

REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: mise run helm:render [chart...] [--cluster <cluster>] [--charts <charts>] [--render-dir <dirs>] [--main-dir <dir>] [--manifest-dir <dir>] [--render-all <true|false>] [--api-versions <versions>] [--parallel-jobs <n>] [--github-output <file>] [--skip-repo-add]"
      echo "Renders Helm templates into individual manifest files in clusters/<cluster>/manifests/<chart>/."
      exit 0
      ;;
    --manifest-dir)
      MANIFEST_DIR="$2"
      shift 2
      ;;
    --render-dir)
      # Accepts comma-separated list of charts/dirs
      read -ra SPLIT_RENDER_DIRS <<< "${2//,/ }"
      REMAINING_ARGS+=(--charts "${SPLIT_RENDER_DIRS[*]}")
      shift 2
      ;;
    --render-all)
      RENDER_ALL="$2"
      shift 2
      ;;
    --api-versions)
      API_VERSIONS="$2"
      shift 2
      ;;
    --parallel-jobs)
      PARALLEL_JOBS="$2"
      shift 2
      ;;
    --github-output)
      GITHUB_OUTPUT="$2"
      shift 2
      ;;
    --skip-repo-add)
      SKIP_REPO_ADD=true
      shift
      ;;
    *)
      REMAINING_ARGS+=("$1")
      shift
      ;;
  esac
done

if [ -n "${RENDER_DIR}" ]; then
  read -ra SPLIT_ENV_DIRS <<< "${RENDER_DIR//,/ }"
  REMAINING_ARGS+=(--charts "${SPLIT_ENV_DIRS[*]}")
fi

helm_init "${REMAINING_ARGS[@]}"

if [ -d "${REPO_ROOT}" ]; then
  REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
fi
if [ -d "${MANIFEST_DIR}" ]; then
  MANIFEST_DIR="$(cd "${MANIFEST_DIR}" && pwd)"
fi

if [ "${RENDER_ALL}" = "true" ]; then
  CHARTS=()
  for path in "${HELM_DIR}"/*; do
    if [ -d "${path}" ] && [ -f "${path}/Chart.yaml" ]; then
      CHARTS+=("$(basename "${path}")")
    fi
  done
fi

if [ ${#CHARTS[@]} -eq 0 ]; then
  log_info "No charts specified or found for rendering. Exiting."
  if [ -n "${GITHUB_OUTPUT:-}" ]; then
    echo "changes-detected=false" >> "${GITHUB_OUTPUT}"
    echo "changed-charts-csv=" >> "${GITHUB_OUTPUT}"
    echo "changed-charts=" >> "${GITHUB_OUTPUT}"
  fi
  exit 0
fi

# Clean output manifest directories
log_step "Cleaning target manifest directories in ${MANIFEST_DIR}/clusters/${CLUSTER}/manifests"
if [[ "${RENDER_ALL}" == "true" ]]; then
  log_info "Full render detected: clearing all manifests for cluster ${CLUSTER} ..."
  rm -rf "${MANIFEST_DIR}/clusters/${CLUSTER}/manifests/"*
else
  for C in "${CHARTS[@]}"; do
    CHART_OUTPUT="${MANIFEST_DIR}/clusters/${CLUSTER}/manifests/${C}"
    if [ -d "${CHART_OUTPUT}" ]; then
      rm -rf "${CHART_OUTPUT:?}"/*
    fi
  done
fi

# Add required Helm repositories if not skipped
if [ "${SKIP_REPO_ADD}" = false ]; then
  "${SCRIPT_DIR}/repo" --main-dir "${REPO_ROOT}" --cluster "${CLUSTER}" --charts "${CHARTS[*]}"
fi

# Set up fail tracking directory
FAIL_DIR="$(mktemp -d)"
cleanup() {
  rm -rf "${FAIL_DIR:-}"
}
trap cleanup EXIT

render_chart_target() {
  local C="$1"
  local CHART_PATH="${HELM_DIR}/${C}"
  local OUTPUT_FOLDER="${MANIFEST_DIR}/clusters/${CLUSTER}/manifests/${C}/"

  if [ ! -f "${CHART_PATH}/Chart.yaml" ]; then
    echo ">> Chart.yaml not found for ${C} at ${CHART_PATH}, skipping."
    return 0
  fi

  mkdir -p "${OUTPUT_FOLDER}"

  local RENDER_ARGS=(--chart "${C}" --chart-path "${CHART_PATH}" --split-output-dir "${OUTPUT_FOLDER}" --build-deps --cleanup-raw)
  if [ -n "${API_VERSIONS}" ]; then
    RENDER_ARGS+=(--api-versions "${API_VERSIONS}")
  fi

  if ! render_helm_chart "${RENDER_ARGS[@]}"; then
    touch "${FAIL_DIR}/failed_${C}"
    return 1
  fi

  echo ">> Manifests for ${C} rendered successfully"
  for file in "${OUTPUT_FOLDER}"/*; do
    if [ -f "${file}" ]; then
      echo "  - $(basename "${file}")"
    fi
  done
  echo ""
}

export -f render_chart_target render_helm_chart resolve_namespace
export HELM_DIR MANIFEST_DIR CLUSTER API_VERSIONS FAIL_DIR

CHART_COUNT=${#CHARTS[@]}

if [ "${CHART_COUNT}" -eq 1 ]; then
  log_step "Rendering single chart: ${CHARTS[0]}"
  render_chart_target "${CHARTS[0]}"
else
  log_step "Rendering ${CHART_COUNT} charts in parallel (concurrency: ${PARALLEL_JOBS})"
  for C in "${CHARTS[@]}"; do
    echo "${C}"
  done | xargs -P "${PARALLEL_JOBS}" -I {} bash -c 'OUT=$(render_chart_target "$@" 2>&1); printf "%s\n" "$OUT"' _ {}
fi

FAILED_COUNT=$(find "${FAIL_DIR}" -name "failed_*" | wc -l | xargs)
if [ "${FAILED_COUNT}" -gt 0 ]; then
  echo ""
  log_error "Rendering failed for ${FAILED_COUNT} chart(s)!"
  exit 1
fi

echo ""
log_success "All charts rendered successfully."
log_divider

# Detect charts that actually have rendered changes in the manifest directory (if it is a git repo)
CHANGED_CHARTS=""
CHANGED_CHARTS_CSV=""
if [ -d "${MANIFEST_DIR}/.git" ]; then
  CHANGED_CHARTS=$(git -C "${MANIFEST_DIR}" -c core.quotepath=false status --porcelain -uall | (grep -oE "clusters/${CLUSTER}/manifests/[^/]+/" || true) | sed -E "s#clusters/${CLUSTER}/manifests/([^/]+)/#\1#" | sort -u)
  if [ -n "${CHANGED_CHARTS}" ]; then
    CHANGED_CHARTS_CSV=$(echo "${CHANGED_CHARTS}" | paste -sd, -)
  fi
fi

if [ -n "${CHANGED_CHARTS}" ]; then
  log_info "Manifest Changes Detected in Charts:"
  while IFS= read -r C; do
    [ -n "${C}" ] && echo "  - ${C}"
  done <<< "${CHANGED_CHARTS}"
  log_info "Changed Charts (CSV): ${CHANGED_CHARTS_CSV}"
fi

if [ -n "${GITHUB_OUTPUT:-}" ]; then
  if [ -n "${CHANGED_CHARTS}" ]; then
    echo "changes-detected=true" >> "${GITHUB_OUTPUT}"
    echo "changed-charts-csv=${CHANGED_CHARTS_CSV}" >> "${GITHUB_OUTPUT}"
    echo "changed-charts<<EOF" >> "${GITHUB_OUTPUT}"
    echo "${CHANGED_CHARTS}" >> "${GITHUB_OUTPUT}"
    echo "EOF" >> "${GITHUB_OUTPUT}"
  else
    echo "changes-detected=false" >> "${GITHUB_OUTPUT}"
    echo "changed-charts-csv=" >> "${GITHUB_OUTPUT}"
    echo "changed-charts=" >> "${GITHUB_OUTPUT}"
  fi
fi
