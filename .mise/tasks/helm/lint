#!/usr/bin/env bash
#MISE description="Lint Helm charts"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../../.." &>/dev/null && pwd -P))}"
# shellcheck source=../../lib/helm.sh
source "${REPO_ROOT}/.mise/lib/helm.sh"

NAMESPACE="default"
REMAINING_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      echo "Usage: mise run helm:lint [chart...] [--cluster <cluster>] [--charts <charts...>] [--namespace <namespace>]"
      echo "Lints Helm charts in a cluster."
      exit 0
      ;;
    --namespace)
      NAMESPACE="$2"
      shift 2
      ;;
    *)
      REMAINING_ARGS+=("$1")
      shift
      ;;
  esac
done

helm_init "${REMAINING_ARGS[@]}"

if [ ${#CHARTS[@]} -eq 0 ]; then
  log_info "No charts found to lint."
  exit 0
fi

log_step "Linting charts for cluster ${CLUSTER}"
FAILED_CHARTS=()

for C in "${CHARTS[@]}"; do
  C_PATH="${HELM_DIR}/${C}"

  if [ ! -d "${C_PATH}" ]; then
    log_error "Chart directory '${C_PATH}' not found."
    FAILED_CHARTS+=("${C}")
    continue
  fi

  log_step "Linting chart [${C}]"
  if ! helm lint "${C_PATH}" --namespace "${NAMESPACE}"; then
    log_error "Lint failed for ${C}"
    FAILED_CHARTS+=("${C}")
  fi
done

log_divider
if [ ${#FAILED_CHARTS[@]} -gt 0 ]; then
  log_error "Lint failed for chart(s): ${FAILED_CHARTS[*]}"
  exit 1
fi

log_success "All charts passed lint successfully."
