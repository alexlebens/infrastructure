#!/usr/bin/env bash
#MISE description="Update dependencies and lint all Helm charts in a cluster"
set -euo pipefail

CLUSTER="${1:-${CLUSTER:-cl01tl}}"
HELM_DIR="${MISE_PROJECT_ROOT:-.}/clusters/${CLUSTER}/helm"

if [ ! -d "${HELM_DIR}" ]; then
  echo "Error: Directory not found: ${HELM_DIR}" >&2
  exit 1
fi

echo "Updating Helm repositories..."
helm repo update > /dev/null

for path in "${HELM_DIR}"/*; do
  if [ -d "${path}" ]; then
    echo ""
    pushd "${path}" > /dev/null || continue

    echo ">> $(basename "${path}")"
    echo ""

    helm dependency update > /dev/null
    helm lint ./

    popd > /dev/null
    echo ""
    echo "-----"
  fi
done
