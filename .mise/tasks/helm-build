#!/usr/bin/env bash
#MISE description="Update repositories, build dependencies, and lint Helm charts"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../.." &>/dev/null && pwd -P))}"

CLUSTER="${CLUSTER:-cl01tl}"
CHARTS=()
REPOS_ONLY=false
SKIP_REPO_UPDATE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --main-dir)
      REPO_ROOT="$2"
      shift 2
      ;;
    --cluster)
      CLUSTER="$2"
      shift 2
      ;;
    --repos-only)
      REPOS_ONLY=true
      shift
      ;;
    --skip-repo-update)
      SKIP_REPO_UPDATE=true
      shift
      ;;
    --chart)
      CHARTS+=("$2")
      shift 2
      ;;
    --charts)
      read -ra SPLIT_CHARTS <<< "$2"
      CHARTS+=("${SPLIT_CHARTS[@]}")
      shift 2
      ;;
    -h|--help)
      echo "Usage: mise run helm-build [chart...] [--cluster <cluster>] [--repos-only] [--skip-repo-update]"
      echo "Discovers repos, updates dependencies, and lints charts in a cluster."
      exit 0
      ;;
    *)
      CHARTS+=("$1")
      shift
      ;;
  esac
done

HELM_DIR="${REPO_ROOT}/clusters/${CLUSTER}/helm"

if [ ! -d "${HELM_DIR}" ]; then
  echo "Error: Directory not found: ${HELM_DIR}" >&2
  exit 1
fi

# If no charts specified, target all charts
if [ ${#CHARTS[@]} -eq 0 ]; then
  for path in "${HELM_DIR}"/*; do
    if [ -d "${path}" ] && [ -f "${path}/Chart.yaml" ]; then
      CHARTS+=("$(basename "${path}")")
    fi
  done
fi

if [ ${#CHARTS[@]} -eq 0 ]; then
  echo ">> No charts found to build."
  exit 0
fi

# Function: Register and update Helm repositories
update_repos() {
  echo ">> Checking dependencies for chart(s): ${CHARTS[*]} ..."

  local REPO_LIST
  REPO_LIST=$(
    for C in "${CHARTS[@]}"; do
      local C_NAME
      C_NAME=$(basename "${C}")
      local CHART_PATH="${HELM_DIR}/${C_NAME}"
      if [ -f "${CHART_PATH}/Chart.yaml" ]; then
        helm dependency list --max-col-width 120 "${CHART_PATH}" 2>/dev/null || true
      fi
    done | awk '$1 != "NAME" && $3 !~ /^oci:\/\// && NF >= 3 { print $1, $3 }' | sort -u
  )

  if [ -n "${REPO_LIST}" ]; then
    echo ">> Registering Helm repositories ..."
    while read -r REPO_NAME REPO_URL; do
      if [ -n "${REPO_NAME}" ] && [ -n "${REPO_URL}" ]; then
        echo ">> Adding repo: ${REPO_NAME} (${REPO_URL})"
        helm repo add "${REPO_NAME}" "${REPO_URL}" --force-update >/dev/null 2>&1 || true
      fi
    done <<< "${REPO_LIST}"

    if [ "$(helm repo list 2>/dev/null | wc -l)" -gt 1 ]; then
      echo ">> Updating repository cache ..."
      helm repo update >/dev/null 2>&1 || true
    fi
  else
    echo ">> No external Helm repositories required."
  fi

  echo ""
  echo "----"
}

# Step 1: Update required Helm repositories unless skipped
if [ "${SKIP_REPO_UPDATE}" = false ]; then
  update_repos
fi

if [ "${REPOS_ONLY}" = true ]; then
  echo "✓ Helm repositories updated successfully."
  exit 0
fi

# Step 2: Build dependencies and lint charts
echo ">> Building dependencies and linting charts for cluster ${CLUSTER} ..."
FAILED_CHARTS=()

for C in "${CHARTS[@]}"; do
  C_NAME=$(basename "${C}")
  C_PATH="${HELM_DIR}/${C_NAME}"

  if [ ! -d "${C_PATH}" ]; then
    echo "Error: Chart directory '${C_PATH}' not found." >&2
    FAILED_CHARTS+=("${C_NAME}")
    continue
  fi

  echo ""
  echo ">> [${C_NAME}] Building dependencies..."
  if ! (helm dependency build "${C_PATH}" --skip-refresh 2>/dev/null || helm dependency update "${C_PATH}" --skip-refresh >/dev/null); then
    echo "Error: Failed to build dependencies for ${C_NAME}" >&2
    FAILED_CHARTS+=("${C_NAME}")
    continue
  fi

  echo ">> [${C_NAME}] Linting chart..."
  if ! helm lint "${C_PATH}" --namespace "default"; then
    echo "Error: Lint failed for ${C_NAME}" >&2
    FAILED_CHARTS+=("${C_NAME}")
  fi
done

echo ""
echo "-----"
if [ ${#FAILED_CHARTS[@]} -gt 0 ]; then
  echo "✗ Errors encountered in chart(s): ${FAILED_CHARTS[*]}" >&2
  exit 1
else
  echo "✓ All charts built and linted successfully!"
fi
