#!/usr/bin/env bash
#MISE description="Discover and register Helm repositories from all cluster charts"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../.." &>/dev/null && pwd -P))"

CLUSTER="${1:-cl01tl}"
HELM_DIR="${REPO_ROOT}/clusters/${CLUSTER}/helm"

if [ ! -d "${HELM_DIR}" ]; then
  echo "Error: Directory not found: ${HELM_DIR}" >&2
  exit 1
fi

helm repo list 2>/dev/null | awk 'NR>1 {print $1}' | xargs -r helm repo remove 2>/dev/null || true

for path in "${HELM_DIR}"/*; do
  if [ -d "${path}" ]; then
    echo ""
    echo "$(basename "${path}")"
    echo ""
    helm dependency list --max-col-width 120 "${path}" 2> /dev/null \
      | tail -n +2 \
      | awk 'NF > 0 { print $1, $3 }' \
      | while read -r REPO_NAME REPO_URL; do
        if [[ "${REPO_URL}" == oci://* ]]; then
          echo ">> Ignoring OCI repo: ${REPO_URL}"
        elif [[ -n "${REPO_NAME}" && -n "${REPO_URL}" ]]; then
          helm repo add "${REPO_NAME}" "${REPO_URL}"
        fi
      done || true
    echo ""
    echo "-----"
  fi
done

helm repo update
