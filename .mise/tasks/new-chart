#!/usr/bin/env bash
#MISE description="Scaffold a new homelab Helm chart from .helm-starters/app-template"
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)"
REPO_ROOT="${MISE_PROJECT_ROOT:-$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || (cd -- "$SCRIPT_DIR/../.." &>/dev/null && pwd -P))}"
# shellcheck source=../lib/log.sh
source "${REPO_ROOT}/.mise/lib/log.sh"

if [ -z "${1:-}" ]; then
  log_fatal "Usage: mise run new-chart <name> [namespace]"
fi

NAME="$1"
NS="${2:-$NAME}"

CLUSTER="${CLUSTER:-cl01tl}"
DEST="${REPO_ROOT}/clusters/${CLUSTER}/helm/$NAME"
if [ -d "$DEST" ]; then
  log_fatal "Directory '$DEST' already exists."
fi

log_step "Scaffolding chart '$NAME' in namespace '$NS' at $DEST..."
mkdir -p "$DEST"
cp -r "${REPO_ROOT}/.helm-starters/app-template/"* "$DEST/"
find "$DEST" -type f ! -name "*.gitkeep" -exec sed -i '' "s/<APP_NAME>/$NAME/g" {} +
find "$DEST" -type f ! -name "*.gitkeep" -exec sed -i '' "s/<NAMESPACE>/$NS/g" {} +

log_success "Created chart at $DEST"
log_info "Next steps:"
log_info "  1. Update image and configuration in $DEST/values.yaml"
log_info "  2. Update $DEST/values.schema.json if adding required fields"
log_info "  3. Validate chart with: mise run check-chart $NAME"
