{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "mergeConfidence:all-badges", ":rebaseStalePrs"],
  "timezone": "America/Chicago",
  "labels": [],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "pinDigests": true,
  "baseBranchPatterns": ["main"],
  "separateMinorPatch": true,
  "customManagers": [
    {
      "description": "Renovate tag matcher for Helm chart appVersion",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Chart\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+appVersion:\\s*[\"']?v?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Renovate tag matcher for Helm values and templates",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)values\\.yaml$/", "/(^|/)templates/.*\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+(?:tag|version):\\s*[\"']?(?<currentValue>[^@\\s\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?",
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+image:\\s*[\"']?(?<packageName>[^@\\s\"']+):(?<currentValue>[^@:\\s\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "description": "Update Helm version in GitHub Actions env",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.gitea/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["HELM_VERSION: \"(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Kubectl version in GitHub Actions env",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.gitea/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["KUBECTL_VERSION: \"(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update ArgoCD version in GitHub Actions env",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.gitea/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["ARGOCD_VERSION: \"(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update yq version in GitHub Actions env",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.gitea/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["YQ_VERSION: \"(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "mikefarah/yq",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update Trivy version in GitHub Actions env",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.gitea/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["TRIVY_VERSION: \"(?<currentValue>v?\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update dclint version in GitHub Actions env",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.gitea/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["DCLINT_VERSION: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "dclint",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "description": "Renovate updater for Navidrome install_plugin bash scripts",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)values\\.yaml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*install_plugin\\s+[\"'][^\"']+[\"']\\s+[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Label dependency",
      "matchPackageNames": ["*"],
      "addLabels": ["{{{datasource}}}"]
    },
    {
      "description": "Versioning for LinuxServer images",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:[-_][a-zA-Z0-9.]+)*-ls(?<revision>\\d+)$",
      "matchPackageNames": ["/^linuxserver//", "/^ghcr\\.io/linuxserver//", "/^lscr\\.io/linuxserver//"]
    },
    {
      "description": "Versioning for LinuxServer nightly images",
      "matchPackageNames": ["/^linuxserver//", "/^ghcr\\.io/linuxserver//", "/^lscr\\.io/linuxserver//"],
      "matchCurrentValue": "/-nightly$/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-nightly$",
      "ignoreUnstable": false
    },
    {
      "description": "Restrict qbittorrent tags to specific format",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_v(?<compatibility>\\d+\\.\\d+\\.\\d+)-ls(?<revision>\\d+)$",
      "matchPackageNames": [
        "linuxserver/qbittorrent",
        "ghcr.io/linuxserver/qbittorrent",
        "lscr.io/linuxserver/qbittorrent"
      ]
    },
    {
      "description": "Disable updates to digests by default",
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Automerge digest updates, specific packages",
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["excalidraw/excalidraw", "searxng/searxng", "d3fk/s3cmd", "ghcr.io/jellyfin/jellyfin"],
      "addLabels": ["automerge"],
      "enabled": true,
      "automerge": true
    },
    {
      "description": "Automerge patches",
      "matchUpdateTypes": ["patch"],
      "addLabels": ["{{{datasource}}}", "automerge"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Automerge minor, specific packages, without release age",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": [
        "/(^|/|-)(actual)/",
        "/(^|/|-)(alloy)/",
        "/(^|/|-)(blog)/",
        "/(^|/|-)(clickhouse)/",
        "/(^|/|-)(code-server)/",
        "/(^|/|-)(docs)/",
        "/(^|/|-)(elasticsearch-exporter)/",
        "/(^|/|-)(grafana)/",
        "/(^|/|-)(home-assistant)/",
        "/(^|/|-)(homepage)/",
        "/(^|/|-)(kaneo)/",
        "/(^|/|-)(karakeep)/",
        "/(^|/|-)(kube-prometheus-stack)/",
        "/(^|/|-)(libation|Libation)/",
        "/(^|/|-)(lidarr)/",
        "/(^|/|-)(loki)/",
        "/(^|/|-)(medialyze|MediaLyze)/",
        "/(^|/|-)(musicgrabber)/",
        "/(^|/|-)(node-exporter)/",
        "/(^|/|-)(ollama)/",
        "/(^|/|-)(open-webui)/",
        "/(^|/|-)(outline)/",
        "/(^|/|-)(php)/",
        "/(^|/|-)(plex)/",
        "/(^|/|-)(prowlarr)/",
        "/(^|/|-)(qui)/",
        "/(^|/|-)(radarr)/",
        "/(^|/|-)(renovate)/",
        "/(^|/|-)(site-saralebens)/",
        "/(^|/|-)(sonarr)/",
        "/(^|/|-)(tdarr)/",
        "/(^|/|-)(temporal)/",
        "/(^|/|-)(traefik)/",
        "/(^|/|-)(valkey)/",
        "/(^|/|-)(version-checker)/",
        "/(^|/|-)(whodb)/",
        "/(^|/|-)(yubal)/"
      ],
      "addLabels": ["{{{datasource}}}", "automerge"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Disable minimum release age for ghcr and quay docker dependencies",
      "matchDatasources": ["github-tags", "github-releases", "git-refs", "docker"],
      "matchPackageNames": ["/^ghcr\\.io//", "/^quay\\.io//", "/^harbor\\.alexlebens\\.dev//"],
      "minimumReleaseAge": ""
    },
    {
      "description": "Disable automerge for openbao-snapshot-agent",
      "matchPackageNames": ["ghcr.io/openbao/openbao-snapshot-agent"],
      "automerge": false,
      "labels": ["{{{datasource}}}"]
    }
  ]
}
