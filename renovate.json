{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "mergeConfidence:all-badges", ":rebaseStalePrs"],
  "timezone": "America/Chicago",
  "registryAliases": {
    "harbor.alexlebens.dev/proxy-hub.docker": "index.docker.io",
    "harbor.alexlebens.dev/proxy-ghcr.io": "ghcr.io",
    "harbor.alexlebens.dev/proxy-gcr.io": "gcr.io",
    "harbor.alexlebens.dev/proxy-quay.io": "quay.io",
    "harbor.alexlebens.dev/proxy-registry.k8s": "registry.k8s.io"
  },
  "labels": [],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "pinDigests": true,
  "baseBranchPatterns": ["main"],
  "ignorePaths": [".helm-starters/**", ".mise/tests/bash/test_helper/**"],
  "separateMinorPatch": true,
  "customManagers": [
    {
      "description": "Renovate tag matcher for Helm chart appVersion",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Chart\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)(?:\\s+registryUrl=(?<registryUrl>\\S+))?\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+appVersion:\\s*[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}{{#if (equals datasource 'docker')}}docker{{else}}semver-coerced{{/if}}{{/if}}"
    },
    {
      "description": "Renovate tag matcher for Helm values and templates",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)values\\.yaml$/", "/(^|/)templates/.*\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+(?:tag|version):\\s*[\"']?(?<currentValue>[^@\\s\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?",
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s+image:\\s*[\"']?(?<packageName>[^@\\s\"']+):(?<currentValue>[^@:\\s\"']+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "description": "Renovate updater for Navidrome install_plugin bash scripts",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)values\\.yaml$", "/(^|/)scripts/.*\\.sh$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*install_plugin\\s+[\"'][^\"']+[\"']\\s+[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "versioningTemplate": "semver-coerced"
    },
    {
      "description": "Renovate updater for Dockerfile ENV versions",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile.*$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\nENV\\s+[A-Za-z0-9_]+_VERSION=[\"']?(?<currentValue>[^\\s\"']+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Handle Docker registries without release timestamps gracefully",
      "matchDatasources": ["docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Do not pin digest for renovate image, track floating major tag",
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "pinDigests": false
    },
    {
      "description": "Label dependency",
      "matchPackageNames": ["*"],
      "addLabels": ["{{{datasource}}}"]
    },
    {
      "description": "Versioning for LinuxServer images",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:[-_][a-zA-Z0-9.]+)*-ls(?<revision>\\d+)$",
      "matchPackageNames": ["/^linuxserver//", "/^ghcr\\.io/linuxserver//", "/^lscr\\.io/linuxserver//"]
    },
    {
      "description": "Versioning for LinuxServer nightly images",
      "matchPackageNames": ["/^linuxserver//", "/^ghcr\\.io/linuxserver//", "/^lscr\\.io/linuxserver//"],
      "matchCurrentValue": "/-nightly$/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-nightly$",
      "ignoreUnstable": false
    },
    {
      "description": "Restrict qbittorrent tags to specific format",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_v(?<compatibility>\\d+\\.\\d+\\.\\d+)-ls(?<revision>\\d+)$",
      "matchPackageNames": [
        "linuxserver/qbittorrent",
        "ghcr.io/linuxserver/qbittorrent",
        "lscr.io/linuxserver/qbittorrent"
      ]
    },
    {
      "description": "Versioning for llama.cpp server CPU images",
      "matchPackageNames": ["ghcr.io/ggml-org/llama.cpp"],
      "matchCurrentValue": "/^server-b\\d+/",
      "versioning": "regex:^server-b(?<patch>\\d+)$"
    },
    {
      "description": "Versioning for llama.cpp server CUDA images",
      "matchPackageNames": ["ghcr.io/ggml-org/llama.cpp"],
      "matchCurrentValue": "/^server-cuda-b\\d+/",
      "versioning": "regex:^server-cuda-b(?<patch>\\d+)$"
    },
    {
      "description": "Group and throttle llama.cpp server updates",
      "matchPackageNames": ["ghcr.io/ggml-org/llama.cpp"],
      "groupName": "llama.cpp",
      "schedule": ["every weekend"],
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Disable updates to digests by default",
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "description": "Automerge digest updates, specific packages",
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["excalidraw/excalidraw", "searxng/searxng", "d3fk/s3cmd"],
      "addLabels": ["automerge"],
      "enabled": true,
      "automerge": true
    },
    {
      "description": "Automerge patches",
      "matchUpdateTypes": ["patch"],
      "addLabels": ["{{{datasource}}}", "automerge"],
      "automerge": true,
      "minimumReleaseAge": "1 days"
    },
    {
      "description": "Automerge minor, specific packages, without release age",
      "matchUpdateTypes": ["minor"],
      "matchPackageNames": [
        "/(^|/|-)(actual)/",
        "/(^|/|-)(alloy)/",
        "/(^|/|-)(alpine)/",
        "/(^|/|-)(bifrost)/",
        "/(^|/|-)(blog)/",
        "/(^|/|-)(clickhouse)/",
        "/(^|/|-)(code-server)/",
        "/(^|/|-)(dawarich)/",
        "/(^|/|-)(docs)/",
        "/(^|/|-)(elasticsearch-exporter)/",
        "/(^|/|-)(feishin)/",
        "/(^|/|-)(garage-ui)/",
        "/(^|/|-)(gitea-mcp-server)/",
        "/(^|/|-)(grafana)/",
        "/(^|/|-)(grimmory)/",
        "/(^|/|-)(grocy)/",
        "/(^|/|-)(home-assistant)/",
        "/(^|/|-)(homebox)/",
        "/(^|/|-)(homepage)/",
        "/(^|/|-)(immich)/",
        "/(^|/|-)(kaneo)/",
        "/(^|/|-)(karakeep)/",
        "/(^|/|-)(kube-prometheus-stack)/",
        "/(^|/|-)(libation|Libation)/",
        "/(^|/|-)(lidarr)/",
        "/(^|/|-)(loki)/",
        "/(^|/|-)(mealie)/",
        "/(^|/|-)(medialyze|MediaLyze)/",
        "/(^|/|-)(musicgrabber)/",
        "/(^|/|-)(n8n)/",
        "/(^|/|-)(node-exporter)/",
        "/(^|/|-)(omni-tools)/",
        "/(^|/|-)(opentofu|tofu)/",
        "/(^|/|-)(outline)/",
        "/(^|/|-)(paperless-ngx)/",
        "/(^|/|-)(php)/",
        "/(^|/|-)(pipedash)/",
        "/(^|/|-)(plex)/",
        "/(^|/|-)(postiz)/",
        "/(^|/|-)(prowlarr)/",
        "/(^|/|-)(qbit_manage)/",
        "/(^|/|-)(qui)/",
        "/(^|/|-)(radarr)/",
        "/(^|/|-)(reactive-resume)/",
        "/(^|/|-)(renovate)/",
        "/(^|/|-)(shelfmark)/",
        "/(^|/|-)(sonarr)/",
        "/(^|/|-)(sparkyfitness)/",
        "/(^|/|-)(subwave)/",
        "/(^|/|-)(tdarr)/",
        "/(^|/|-)(temporal)/",
        "/(^|/|-)(thingport)/",
        "/(^|/|-)(traefik)/",
        "/(^|/|-)(trek)/",
        "/(^|/|-)(unpoller)/",
        "/(^|/|-)(valkey)/",
        "/(^|/|-)(version-checker)/",
        "/(^|/|-)(whodb)/"
      ],
      "addLabels": ["{{{datasource}}}", "automerge"],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Disable automerge for openbao-snapshot-agent",
      "matchPackageNames": ["ghcr.io/openbao/openbao-snapshot-agent"],
      "automerge": false,
      "labels": ["{{{datasource}}}"]
    },
    {
      "description": "Disable automerge for ceph",
      "matchPackageNames": ["quay.io/ceph/ceph", "ceph/ceph"],
      "automerge": false,
      "labels": ["{{{datasource}}}"]
    },
    {
      "description": "Group Prettier updates",
      "matchPackageNames": ["prettier"],
      "groupName": "prettier"
    },
    {
      "description": "Group Tailscale images and operator Helm chart",
      "matchPackageNames": [
        "tailscale/tailscale",
        "tailscale/k8s-operator",
        "tailscale/k8s-nameserver",
        "tailscale-operator"
      ],
      "groupName": "tailscale"
    },
    {
      "description": "Group mise.toml updates per tool and delay 3 days",
      "matchManagers": ["mise"],
      "matchFileNames": ["mise.toml"],
      "groupName": "{{replace '^.*/' '' depName}} tool update",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group and throttle runner Dockerfile updates to weekends",
      "matchFileNames": ["images/runner/Dockerfile"],
      "groupName": "runner image",
      "schedule": ["every weekend"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group ArgoCD across mise.toml, workflows, and in-cluster Helm chart",
      "matchPackageNames": [
        "argocd",
        "argo-cd",
        "argoproj/argo-cd",
        "quay.io/argoproj/argocd",
        "harbor.alexlebens.dev/proxy-quay.io/argoproj/argocd"
      ],
      "groupName": "argocd tool update",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group kubectl across mise.toml, workflows, and in-cluster images",
      "matchPackageNames": [
        "kubectl",
        "kubernetes/kubernetes",
        "alpine/k8s",
        "registry.k8s.io/kubectl",
        "harbor.alexlebens.dev/proxy-registry.k8s/kubectl"
      ],
      "groupName": "kubectl tool update",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group Helm across mise.toml and workflows",
      "matchPackageNames": ["helm", "helm/helm", "alpine/helm", "harbor.alexlebens.dev/proxy-hub.docker/alpine/helm"],
      "groupName": "helm tool update",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group OpenTofu across mise.toml and workflows",
      "matchPackageNames": [
        "opentofu",
        "opentofu/opentofu",
        "ghcr.io/opentofu/opentofu",
        "harbor.alexlebens.dev/proxy-ghcr.io/opentofu/opentofu"
      ],
      "groupName": "opentofu tool update",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group OpenBao across mise.toml and in-cluster Helm chart",
      "matchPackageNames": [
        "openbao",
        "openbao/openbao",
        "quay.io/openbao/openbao",
        "harbor.alexlebens.dev/proxy-quay.io/openbao/openbao"
      ],
      "groupName": "openbao tool update",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group Trivy across mise.toml and workflows",
      "matchPackageNames": [
        "trivy",
        "aquasec/trivy",
        "aquasecurity/trivy",
        "harbor.alexlebens.dev/proxy-hub.docker/aquasec/trivy"
      ],
      "groupName": "trivy tool update",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group Python across mise.toml and in-cluster images",
      "matchPackageNames": ["python", "python/cpython"],
      "groupName": "python tool update",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group kube-prometheus-stack Helm chart dependency and appVersion",
      "matchPackageNames": ["kube-prometheus-stack", "ghcr.io/prometheus-community/charts/kube-prometheus-stack"],
      "groupName": "kube-prometheus-stack"
    },
    {
      "description": "Group Harbor appVersion and subcomponent container images",
      "matchPackageNames": ["goharbor/harbor", "goharbor/registry-photon", "/^ghcr\\.io/goharbor//"],
      "groupName": "harbor"
    }
  ]
}
