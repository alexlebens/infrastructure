{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "DOWN" },
                "1": { "color": "green", "text": "UP" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "title": "Instance Status",
      "type": "stat",
      "targets": [
        {
          "expr": "mongodb_up{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "title": "Uptime",
      "type": "stat",
      "targets": [
        {
          "expr": "mongodb_instance_uptime_seconds{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "title": "Current Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(mongodb_connections{namespace=~\"$namespace\", pod=~\"$pod\", state=\"current\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "title": "Available Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(mongodb_connections{namespace=~\"$namespace\", pod=~\"$pod\", state=\"available\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "title": "Active Read Clients",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(mongodb_global_lock_active_clients{namespace=~\"$namespace\", pod=~\"$pod\", type=\"readers\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "title": "Active Write Clients",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(mongodb_global_lock_active_clients{namespace=~\"$namespace\", pod=~\"$pod\", type=\"writers\"}) by (pod)",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 8,
      "title": "Operations & Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 9,
      "title": "Operations Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (type) (rate(mongodb_op_counters_total{namespace=~\"$namespace\", pod=~\"$pod\"}[2m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 10,
      "title": "Network Traffic",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(mongodb_network_bytes_total{namespace=~\"$namespace\", pod=~\"$pod\", state=\"in_bytes\"}[2m]))",
          "legendFormat": "Inbound",
          "refId": "A"
        },
        {
          "expr": "sum(rate(mongodb_network_bytes_total{namespace=~\"$namespace\", pod=~\"$pod\", state=\"out_bytes\"}[2m]))",
          "legendFormat": "Outbound",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 11,
      "title": "Replication & WiredTiger Cache",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 12,
      "title": "Replication Lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "mongodb_mongod_replset_member_replication_lag{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "{{member}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 13,
      "title": "WiredTiger Cache Bytes",
      "type": "timeseries",
      "targets": [
        {
          "expr": "mongodb_ss_wiredTiger_cache_bytes_currently_in_the_cache{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "Currently in Cache - {{pod}}",
          "refId": "A"
        },
        {
          "expr": "mongodb_ss_wiredTiger_cache_maximum_bytes_configured{namespace=~\"$namespace\", pod=~\"$pod\"}",
          "legendFormat": "Max Configured - {{pod}}",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["platform", "database"],
  "templating": {
    "list": [
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
        "definition": "label_values(mongodb_up, namespace)",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
        "multi": false,
        "name": "namespace",
        "query": "label_values(mongodb_up, namespace)",
        "refresh": 2,
        "type": "query"
      },
      {
        "current": { "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "kube-prometheus-stack" },
        "definition": "label_values(mongodb_up{namespace=~\"$namespace\"}, pod)",
        "hide": 0,
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "pod",
        "query": "label_values(mongodb_up{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "MongoDB",
  "uid": "mongodb-overview"
}
