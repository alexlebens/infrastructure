{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "enforce_auth_on_inference": true,
    "whitelisted_routes": ["/metrics", "/healthz"]
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "models": ["gemini-3.5-flash-lite", "gemini-3.8-flash"],
          "weight": 1.0
        }
      ]
    },
    "ollama": {
      "network_config": {
        "allow_private_network": true
      },
      "keys": [
        {
          "name": "ollama-desktop",
          "url": "https://ollama-pd05wd.boreal-beaufort.ts.net",
          "ollama_key_config": {
            "url": "https://ollama-pd05wd.boreal-beaufort.ts.net"
          },
          "models": ["gemma4", "gemma4:12b"],
          "weight": 1.0
        },
        {
          "name": "llama-server-gemma4-e4b",
          "url": "http://llama-server-gemma4-e4b.llama-server:8080",
          "ollama_key_config": {
            "url": "http://llama-server-gemma4-e4b.llama-server:8080"
          },
          "value": "env.LLAMA_SERVER_API_KEY",
          "models": ["gemma4", "gemma4:e4b"],
          "weight": 0.0
        },
        {
          "name": "llama-server-embeddinggemma-2",
          "url": "http://llama-server-embeddinggemma-2.llama-server:8081",
          "ollama_key_config": {
            "url": "http://llama-server-embeddinggemma-2.llama-server:8081"
          },
          "value": "env.LLAMA_SERVER_API_KEY",
          "models": ["embeddinggemma-2:latest", "text-embedding-ada-002", "text-embedding-3-small"],
          "weight": 0.0
        }
      ]
    }
  },
  "governance": {
    "routing_rules": [
      {
        "id": "rule-gemma4-routing",
        "name": "gemma4-routing",
        "priority": 0,
        "cel_expression": "request.model == 'gemma4' || request.model == 'gemma4:e4b' || request.model == 'gemma4:12b'",
        "targets": [
          {
            "provider": "ollama",
            "provider_key_name": "ollama-desktop",
            "model": "gemma4:12b",
            "weight": 1.0
          }
        ],
        "fallbacks": [
          {
            "provider": "ollama",
            "provider_key_name": "llama-server-gemma4-e4b",
            "model": "gemma4:e4b"
          }
        ]
      },
      {
        "id": "rule-embeddings-cluster",
        "name": "embeddings-cluster",
        "priority": 1,
        "cel_expression": "request.model == 'embeddinggemma-2:latest' || request.model == 'text-embedding-ada-002' || request.model == 'text-embedding-3-small'",
        "targets": [
          {
            "provider": "ollama",
            "provider_key_name": "llama-server-embeddinggemma-2",
            "model": "embeddinggemma-2:latest",
            "weight": 1.0
          }
        ]
      }
    ],
    "virtual_keys": [
      {
        "id": "vk-librechat",
        "name": "LibreChat Virtual Key",
        "value": "env.LIBRECHAT_VIRTUAL_KEY",
        "description": "Virtual key for LibreChat accessing Gemini and local Ollama inference models",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "gemini",
            "key_ids": ["*"],
            "allowed_models": ["gemini-3.5-flash-lite", "gemini-3.8-flash", "regex:gemini-.*"]
          },
          {
            "provider": "ollama",
            "key_ids": ["*"],
            "allowed_models": ["gemma4", "embeddinggemma-2:latest", "text-embedding-ada-002", "text-embedding-3-small"]
          }
        ]
      },
      {
        "id": "vk-homelab",
        "name": "Homelab Services Virtual Key",
        "value": "env.HOMELAB_VIRTUAL_KEY",
        "description": "Virtual key for internal homelab services restricted to local Ollama inference",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "key_ids": ["*"],
            "allowed_models": ["gemma4", "embeddinggemma-2:latest", "text-embedding-ada-002", "text-embedding-3-small"]
          }
        ]
      }
    ]
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  }
}
