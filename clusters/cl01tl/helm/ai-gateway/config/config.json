{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "enforce_auth_on_inference": true,
    "whitelisted_routes": ["/metrics", "/healthz"]
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "models": ["gemini-3.5-flash-lite", "gemini-3.8-flash"],
          "weight": 1.0
        }
      ]
    },
    "ollama": {
      "network_config": {
        "allow_private_network": true
      },
      "keys": [
        {
          "name": "ollama-desktop",
          "url": "https://ollama-pd05wd.boreal-beaufort.ts.net",
          "ollama_key_config": {
            "url": "https://ollama-pd05wd.boreal-beaufort.ts.net"
          },
          "models": [
            "gemma4:e4b",
            "embeddinggemma:latest",
            "embeddinggemma-2:latest",
            "text-embedding-ada-002",
            "text-embedding-3-small",
            "gemma4:12b",
            "qwen3:14b",
            "qwen3.5:4b"
          ],
          "weight": 1.0
        },
        {
          "name": "llama-server-qwen",
          "url": "http://llama-server-qwen.llama-server:8080",
          "ollama_key_config": {
            "url": "http://llama-server-qwen.llama-server:8080"
          },
          "value": "env.LLAMA_SERVER_API_KEY",
          "models": ["qwen3.5:4b"],
          "weight": 0.0
        },
        {
          "name": "llama-server-embeddings",
          "url": "http://llama-server-embeddings.llama-server:8081",
          "ollama_key_config": {
            "url": "http://llama-server-embeddings.llama-server:8081"
          },
          "value": "env.LLAMA_SERVER_API_KEY",
          "models": ["embeddinggemma:latest", "text-embedding-ada-002", "text-embedding-3-small"],
          "weight": 0.0
        },
        {
          "name": "llama-server-embeddings-2",
          "url": "http://llama-server-embeddings-2.llama-server:8082",
          "ollama_key_config": {
            "url": "http://llama-server-embeddings-2.llama-server:8082"
          },
          "value": "env.LLAMA_SERVER_API_KEY",
          "models": ["embeddinggemma-2:latest"],
          "weight": 0.0
        },
        {
          "name": "ollama-cluster",
          "url": "http://ollama-server.ollama:11434",
          "ollama_key_config": {
            "url": "http://ollama-server.ollama:11434"
          },
          "models": ["gemma4:e4b", "embeddinggemma:latest", "text-embedding-ada-002", "text-embedding-3-small"],
          "weight": 0.0
        }
      ]
    }
  },
  "governance": {
    "routing_rules": [
      {
        "name": "ollama-desktop-with-cluster-fallback",
        "match_expression": "request.provider == 'ollama'",
        "targets": [
          {
            "provider": "ollama",
            "provider_key_name": "ollama-desktop"
          }
        ],
        "fallbacks": [
          {
            "provider": "ollama",
            "provider_key_name": "llama-server-qwen"
          },
          {
            "provider": "ollama",
            "provider_key_name": "llama-server-embeddings"
          },
          {
            "provider": "ollama",
            "provider_key_name": "llama-server-embeddings-2"
          },
          {
            "provider": "ollama",
            "provider_key_name": "ollama-cluster"
          }
        ]
      }
    ],
    "virtual_keys": [
      {
        "id": "vk-librechat",
        "name": "LibreChat Virtual Key",
        "value": "env.LIBRECHAT_VIRTUAL_KEY",
        "description": "Virtual key for LibreChat accessing Gemini and local Ollama inference models",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "gemini",
            "allow_all_providers": false,
            "key_ids": ["*"],
            "allowed_models": ["gemini-3.5-flash-lite", "gemini-3.8-flash", "regex:gemini-.*"]
          },
          {
            "provider": "ollama",
            "allow_all_providers": false,
            "key_ids": ["*"],
            "allowed_models": [
              "gemma4:e4b",
              "gemma4:12b",
              "qwen3:14b",
              "qwen3.5:4b",
              "embeddinggemma:latest",
              "embeddinggemma-2:latest",
              "text-embedding-ada-002",
              "text-embedding-3-small"
            ]
          }
        ]
      },
      {
        "id": "vk-homelab",
        "name": "Homelab Services Virtual Key",
        "value": "env.HOMELAB_VIRTUAL_KEY",
        "description": "Virtual key for internal homelab services restricted to local Ollama inference",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "ollama",
            "allow_all_providers": false,
            "key_ids": ["*"],
            "allowed_models": [
              "gemma4:e4b",
              "gemma4:12b",
              "qwen3:14b",
              "qwen3.5:4b",
              "embeddinggemma:latest",
              "embeddinggemma-2:latest",
              "text-embedding-ada-002",
              "text-embedding-3-small"
            ]
          }
        ]
      }
    ]
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  }
}
