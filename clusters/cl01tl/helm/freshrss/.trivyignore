# FreshRSS requires root entrypoint to bind port 80 and configure Apache before dropping to user 568
# https://avd.aquasec.com/misconfig/ksv-0012 (Runs as root user)
KSV-0012
AVD-KSV-0012

# FreshRSS dynamically generates Apache and PHP configs at startup
# https://avd.aquasec.com/misconfig/ksv-0014 (Root file system is not read-only)
KSV-0014
AVD-KSV-0014

# FreshRSS Apache entrypoint requires SETUID, SETGID, CHOWN, DAC_OVERRIDE, FOWNER capabilities
# https://avd.aquasec.com/misconfig/ksv-0022 (Added capabilities)
KSV-0022
AVD-KSV-0022
