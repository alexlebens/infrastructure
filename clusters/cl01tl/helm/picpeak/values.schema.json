{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "picpeak",
    "pocket-id-client",
    "postgres-18-cluster",
    "s3-bucket",
    "volsync-target-data",
    "common-helpers"
  ],
  "properties": {
    "picpeak": {
      "type": "object",
      "required": ["controllers", "service", "route", "persistence"],
      "properties": {
        "controllers": {
          "type": "object",
          "required": ["main"],
          "properties": {
            "main": {
              "type": "object",
              "required": ["containers"],
              "properties": {
                "containers": {
                  "type": "object",
                  "required": ["main"],
                  "properties": {
                    "main": {
                      "type": "object",
                      "required": ["image"],
                      "properties": {
                        "image": {
                          "type": "object",
                          "required": ["repository", "tag"],
                          "properties": {
                            "repository": {
                              "type": "string",
                              "minLength": 1
                            },
                            "tag": {
                              "type": "string",
                              "minLength": 1,
                              "not": {
                                "const": "latest"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "service": {
          "type": "object",
          "required": ["main"]
        },
        "route": {
          "type": "object",
          "required": ["main"]
        },
        "persistence": {
          "type": "object",
          "required": ["data", "config", "external-media", "artists", "museums", "pictures", "tmp"]
        }
      }
    },
    "pocket-id-client": {
      "type": "object",
      "required": ["mode", "client"]
    },
    "postgres-18-cluster": {
      "type": "object",
      "required": ["mode", "cluster", "recovery", "backup"]
    },
    "s3-bucket": {
      "type": "object",
      "required": ["enabled", "bucketName", "target", "backups"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bucketName": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "volsync-target-data": {
      "type": "object",
      "required": ["pvcTarget", "a", "c", "d"]
    },
    "common-helpers": {
      "type": "object",
      "required": ["probe"]
    }
  }
}
