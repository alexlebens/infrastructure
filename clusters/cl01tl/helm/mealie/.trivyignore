# Mealie entrypoint (/app/run.sh) starts as root to adjust PUID/PGID and chown /app,
# then drops privileges via gosu to the dedicated user (abc:1000).
# A read-only root filesystem prevents the entrypoint and uvicorn from functioning normally.

# Root file system is not read-only
KSV-0014
AVD-KSV-0014

# Default security context configured
KSV-0118
AVD-KSV-0118

# Can elevate its own privileges (required by gosu in default entrypoint)
KSV-0001
AVD-KSV-0001

# Runs as root user (container entrypoint starts as root before dropping to abc)
KSV-0012
AVD-KSV-0012

# Seccomp policies disabled
KSV-0104
AVD-KSV-0104
KSV-0030
AVD-KSV-0030

# Default capabilities: drop ALL
KSV-0003
AVD-KSV-0003
KSV-0004
AVD-KSV-0004
KSV-0106
AVD-KSV-0106
