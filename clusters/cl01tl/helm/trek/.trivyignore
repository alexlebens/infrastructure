# Trek entrypoint (/usr/local/bin/trek-entrypoint) starts as root to chown /app/data and /app/uploads,
# then drops privileges via gosu to the node user (node:1000).

# Default security context configured (starts as root before gosu drops to node)
KSV-0118
AVD-KSV-0118

# Can elevate its own privileges (required for gosu in default entrypoint)
KSV-0001
AVD-KSV-0001

# Runs as root user (container entrypoint starts as root before dropping to node)
KSV-0012
AVD-KSV-0012

# Specific capabilities added: CHOWN, SETUID, SETGID required for startup chown and gosu privilege dropping
KSV-0022
AVD-KSV-0022
KSV-0106
AVD-KSV-0106
