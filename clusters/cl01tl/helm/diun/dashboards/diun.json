  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "kube-prometheus-stack"
      },
      "description": "Diun application version and build revision",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "/^version$/",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kube-prometheus-stack"
          },
          "expr": "diun_build_info",
          "instant": true,
          "legendFormat": "{{ version }}",
          "refId": "A"
        }
      ],
      "title": "Version",
      "transparent": true,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "kube-prometheus-stack"
      },
      "description": "Timestamp of the last completed image watch run",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                }
              ]
            }
          },
          "unit": "dateTimeFromNow"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kube-prometheus-stack"
          },
          "expr": "diun_watch_last_run_timestamp_seconds * 1000",
          "instant": true,
          "legendFormat": "Last Run",
          "refId": "A"
        }
      ],
      "title": "Last Watch Run",
      "transparent": true,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "kube-prometheus-stack"
      },
      "description": "Cumulative total of completed watch runs since startup",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "blue",
                  "value": 0
                }
              ]
            }
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kube-prometheus-stack"
          },
          "expr": "diun_watch_runs_total",
          "instant": true,
          "legendFormat": "Runs",
          "refId": "A"
        }
      ],
      "title": "Total Watch Runs",
      "transparent": true,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "kube-prometheus-stack"
      },
      "description": "Total watch runs skipped due to an already running job",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "orange",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kube-prometheus-stack"
          },
          "expr": "diun_watch_skipped_runs_total",
          "instant": true,
          "legendFormat": "Skipped",
          "refId": "A"
        }
      ],
      "title": "Skipped Runs",
      "transparent": true,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "kube-prometheus-stack"
      },
      "description": "Watch run executions and skipped runs over time",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Completed Runs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Skipped Runs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["sum", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "13.2.2",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kube-prometheus-stack"
          },
          "expr": "increase(diun_watch_runs_total[1h])",
          "legendFormat": "Completed Runs (per hour)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kube-prometheus-stack"
          },
          "expr": "increase(diun_watch_skipped_runs_total[1h])",
          "legendFormat": "Skipped Runs (per hour)",
          "refId": "B"
        }
      ],
      "title": "Watch Run Activity (Hourly)",
      "transparent": true,
      "type": "timeseries"
    },
    {
